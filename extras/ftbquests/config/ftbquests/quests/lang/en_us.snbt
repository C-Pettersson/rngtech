{
	chapter.37A6C9E1284B5D0F.title: "Start"
	chapter.7106E7A1B10FA010.title: "Stage 1-2: Basic Power"
	chapter.7106E7A1B10FA020.title: "Stage 3-4: Steel Factory"
	chapter.7106E7A1B10FA030.title: "Stage 5-6: Fluids and Chemistry"
	chapter.7106E7A1B10FA040.title: "Stage 7-8: Advanced Power"
	chapter.7106E7A1B10FA050.title: "Logistics and Transport"
	chapter.7106E7A1B10FA060.title: "Affix Forge"
	chapter.7106E7A1B10FA070.title: "Mastery and Ascendancies"
	chapter_group.7106E7A1B10FA000.title: "RNGTech"
	quest.00B991D729BDFC26.quest_desc: [
		"The &eForestry Companion&r is a cart on vanilla rails. It plants saplings beside the track and cuts the trees that grow."
		""
		"&aBuild:&r"
		"- Craft a &eForestry Companion&r."
		"- Place a vanilla rail line through the farm area."
		"- Right-click a rail with the &eForestry Companion&r to place it."
		""
		"&aUse:&r"
		"1. Right-click the cart to open it."
		"2. Install a charged Battery Cell and a &eModular Axe&r or &eModular Treefeller&r."
		"3. Insert saplings in its supply cargo."
		""
		"Install shears to get leaf drops. A &eCompanion Station&r next to the track unloads the harvest, refills saplings, and charges the cart."
		""
		"&7&oNote: The cart does not start without a Battery Cell and an unbroken cutting tool.&r"
	]
	quest.00B991D729BDFC26.quest_subtitle: "A cart that farms trees."
	quest.00B991D729BDFC26.title: "Forestry Companion"
	quest.01C84F033E61813D.quest_desc: [
		"The &eAethergold Battery Chassis&r has the strongest burst identity. It seals its cells, so they do not leak."
		""
		"The &eAethergold Battery Cell&r stores less than a Nullite cell, but it moves FE faster and does not leak."
	]
	quest.025813A9EAA3189B.quest_desc: [
		"The &eCopper Solar Panel&r makes 8 &bFE/t&r on a clear day and 2 &bFE/t&r in rain."
		"Its recipe uses a &eSolar Panel Frame&r and a &eCopper Energy Connector&r."
	]
	quest.034790AECE11EB3C.quest_desc: [
		"The &eTitanium Alloy Furnace&r makes the Stage 7 alloys directly from ingots. These recipes need Stage 6 parts."
		""
		"- &eTungstensteel Ingot&r: 2 Tungsten, 1 Steel, 1 Coal Dust, 1,500 °C"
		"- &eNullite Ingot&r: 3 Lead, 1 Platinum, 2 Ender Pearls, 1,500 °C"
		"- &eAethergold Ingot&r: 3 Tin, 1 Silver, 4 Glowstone Dust, 1,400 °C"
		""
		"Each recipe makes 2 ingots."
	]
	quest.0481EE530E9C6A2E.quest_desc: [
		"From Stage 5, the &eCorrosion Cell&r burns Anodes. An Anode burns twice as long as a plate and makes far more FE."
		""
		"&aBuild:&r"
		"1. Craft an &eAluminum Cathode&r."
		"2. Install the Cathode in the Gear tab of the Corrosion Cell."
		"3. Assemble an &eAluminum Anode&r from two Aluminum Plates and 250 mB of &bElectrolyte Solution&r in the &eComponent Assembler&r."
		""
		"&aUse:&r"
		"- Insert the &eAluminum Anode&r in the Corrosion Cell."
		""
		"&7&oNote: A Cathode burns Anodes of its own stage or lower. Titanium, Tungstensteel, and Naquadah Anodes need a Cathode of the same stage or higher.&r"
	]
	quest.0481EE530E9C6A2E.quest_subtitle: "Better fuel for the Corrosion Cell."
	quest.0481EE530E9C6A2E.title: "Corrosion Anodes"
	quest.0511A72AEC9FAB27.quest_desc: [
		"&eTin&r is the second half of the first bronze lesson."
		""
		"&aBuild:&r"
		"- Collect a &eTin Ingot&r."
		""
		"&aUse:&r"
		"- Crush tin when the Stage 3 bronze path asks for dust."
		"- Treat Tin as an alloy ingredient first, not as a full machine stage."
	]
	quest.0511A72AEC9FAB27.quest_subtitle: "The alloy partner for copper."
	quest.0511A72AEC9FAB27.title: "First Tin"
	quest.053725AB57161D50.quest_desc: ["With the Affix Injector, Affix Upgrader, or Greater Affix Upgrader, the &eConservation Crystal&r gives a 25% chance to keep the catalyst."]
	quest.055FAC8A7D35E178.quest_desc: ["The Affix Forge chapter explains affixes, Refinement Potential, and the &eAffix Forge&r."]
	quest.05CD873FE8F814D1.quest_desc: ["The &eAscension Matrix&r makes a Magic item with one or more affixes Rare. It adds 1 to 4 affixes and upgrades or retunes one affix. It uses all the RP that the item has left."]
	quest.0638FBE9D9A51E0A.quest_desc: [
		"Exotic Gear raises the FE from each Void Catalyst. Unmodified Exotic Gear makes about 3,000 FE/t, against 1,057 FE/t for Tungstensteel."
		""
		"&aBuild:&r"
		"- Craft an &eExotic Void Chamber&r."
		"- Craft an &eExotic Collapse Nozzle&r."
		"- Craft an &eExotic Dimensional Stabilizer&r."
		"- Install all three in the &eVacuum Collapse Generator&r."
		""
		"&7&oNote: The peak output also rises. Make sure that your cables and storage can take it.&r"
	]
	quest.0638FBE9D9A51E0A.quest_subtitle: "The Stage 8 power upgrade."
	quest.0638FBE9D9A51E0A.title: "Exotic Collapse Gear"
	quest.06CF355466851823.quest_desc: [
		"Bronze is your first alloy. You make it from dusts in a crafting grid."
		""
		"&aBuild:&r"
		"1. Mine Tin Ore with a &eCopper Pick Head&r or better. Tin Ore has hardness 2."
		"2. Crush raw Tin into &eCrushed Tin&r, then crush it again into &eTin Dust&r."
		"3. Crush Coal into &eCoal Dust&r."
		"4. Craft 3 &eCopper Dust&r, 1 &eTin Dust&r, and 1 &eCoal Dust&r into 2 &eBronze Blend&r."
		"5. Smelt the &eBronze Blend&r in the &eFurnace&r. It needs 700 °C."
		""
		"&7&oNote: Hammer Bronze Ingots into Bronze Plates with the Forming Hammer. The next machines need Bronze Plates.&r"
	]
	quest.06CF355466851823.quest_subtitle: "Bronze starts in a crafting grid."
	quest.06CF355466851823.title: "First Alloy"
	quest.08CA89C63A70CEDE.quest_desc: [
		"The &eSteel Battery Chassis&r needs a &eCalibrated Storage Component&r with 55 or more stability."
		""
		"&aBuild:&r"
		"1. Craft a &eStorage Calibration Pattern&r from a Cell Shell, paper, and redstone."
		"2. Craft a &eStabilization Catalyst&r from a diamond, Nether Quartz, lapis lazuli, and redstone."
		"3. Calibrate a Cell Shell with the pattern, redstone, and the catalyst."
		""
		"&7&oNote: This recipe rolls a stability from 45 to 80. The Calibrator uses up the catalyst.&r"
	]
	quest.08CA89C63A70CEDE.quest_subtitle: "The Steel Battery Chassis needs it."
	quest.08CA89C63A70CEDE.title: "Calibrated Storage"
	quest.09E6CC376427E6D3.quest_desc: [
		"The &eCrude Recycler&r takes early items apart and gives back some of their materials. It needs no &bFE&r."
		""
		"&aBuild:&r"
		"- Craft a &eCrude Recycler&r and a &eHand Crank&r."
		"- Place the &eCrude Recycler&r."
		"- Place the &eHand Crank&r directly on top of it."
		""
		"&aUse:&r"
		"1. Insert an item in the input slot."
		"2. Close the screen."
		"3. Right-click the &eHand Crank&r until the job is done. A simple job needs 20 turns."
		""
		"It accepts flint, iron, and copper tool heads and rods, early machine blocks, and early Crush Heads."
		""
		"&7&oNote: A recycled item loses its rarity, affixes, and RP.&r"
	]
	quest.09E6CC376427E6D3.quest_subtitle: "Recycle early parts by hand."
	quest.09E6CC376427E6D3.title: "Crude Recycler"
	quest.09EAFEBDB30A3137.quest_desc: [
		"The &eCopper Battery Chassis&r holds 2 cells and has a better transfer rating than the Iron chassis."
		"It leaks a small amount of &bFE&r while idle, and it wastes some of the &bFE&r that it receives."
		""
		"&7&oNote: Choose the Iron Battery Chassis if you want no leakage.&r"
	]
	quest.0B2A8A7AB957B02D.quest_desc: ["Insert the &eYield Modifier Lens&r in the focus slot of the Affix Forge. It makes Yield affixes 3 times as likely."]
	quest.0D0B5AC2FBC6261B.quest_desc: [
		"Optional. The &eLead Furnace Chassis&r is a Stage 4 sidegrade with 4 lanes. One Heat Core heats all 4 lanes."
		"Each lane works at half the base speed."
		""
		"&aBuild:&r"
		"1. Craft a &eLead Furnace Chassis&r. The recipe needs Lead Ingots, an &eAdvanced Electric Circuit&r, and a &eCalibrated Thermal Component&r with 55 or more stability."
		"2. Install one Heat Core and a Battery Cell."
		""
		"&aUse:&r"
		"- Automation fills lane 1 first. The Even Feed Mastery keystone sends each item to the emptiest lane."
	]
	quest.0D0B5AC2FBC6261B.quest_subtitle: "Four lanes share one Heat Core."
	quest.0D0B5AC2FBC6261B.title: "Lead Furnace"
	quest.1003E61C2B6F8611.quest_desc: [
		"Iron heads mine faster than Flint heads and have more durability. They still reach only ore hardness 1."
		""
		"&aBuild:&r"
		"- Craft &eIron Plates&r with the &eForming Hammer&r."
		"- Craft an &eIron Gear&r and &eIron Rods&r."
		"- Craft the Iron Hammer, Digger, and Treefeller heads."
	]
	quest.1003E61C2B6F8611.quest_subtitle: "Optional iron heads for advanced tools."
	quest.1003E61C2B6F8611.title: "Iron Advanced Tools"
	quest.101F072E97133585.quest_desc: [
		"Calibrate an &eIron Gear&r with the &eKinetic Calibration Pattern&r and redstone."
		"The &eSteel Crusher Chassis&r needs 55 or more stability."
	]
	quest.10D59A7D9BDC28C1.quest_desc: [
		"The &eMiner's Companion&r has 3 utilities. It works from your inventory, hotbar, or offhand."
		""
		"- Block Chew deletes unwanted drops, such as cobblestone, when you break a block. It needs a Crush Head."
		"- The Magnet pulls dropped items within 6 blocks to you."
		"- The Mining Lamp gives light like a held torch."
		""
		"&aBuild:&r"
		"- Craft a &eMiner's Companion&r."
		"- Right-click with it to open its screen."
		"- Install a Battery Cell in the Gear tab."
		""
		"&aUse:&r"
		"- Put block items in the filter slots of the Process tab. A ghost slot does not take your item."
		"- Sneak and right-click to turn Block Chew on or off."
		"- Each chewed item costs 16 &bFE&r from the installed cell."
		"- To charge the cell, put the &eMiner's Companion&r in the Tool slot of the &eTool Bench&r."
		""
		"&7&oNote: Every utility needs a charged Battery Cell. The Miner's Companion stores no FE of its own.&r"
	]
	quest.10D59A7D9BDC28C1.quest_subtitle: "A battery gadget for miners."
	quest.117EDD2049951ECF.quest_desc: [
		"Craft &eMastery Refunds&r from paper, redstone, and a copper ingot. One craft makes 8."
		""
		"- One refund removes one node of the shared tree."
		"- One ascendancy node costs 5 refunds."
		"- Shift-click &eClear&r to refund the full tree at the same cost for each node."
		""
		"&7&oNote: After an update changes the tree, the next Clear of each machine is free. The Clear button then glows green.&r"
	]
	quest.117EDD2049951ECF.quest_subtitle: "Remove nodes that you do not need."
	quest.117EDD2049951ECF.title: "Mastery Refunds"
	quest.12A0A2EF0429FF13.quest_desc: [
		"The &eAffix Resonance Matrix&r is the third upgrade for the &eAffix Forge&r. It unlocks these catalysts:"
		"- &eGreater Affix Upgrader&r"
		"- &eAscension Catalyst&r and &eAscension Matrix&r"
		"- &eChaos Crystal&r, &eExpansion Crystal&r, and &eNull Crystal&r"
		"- &eVolatile Catalyst&r"
		""
		"Its recipe needs Calibrated Structural, Conductive, and Logic Components with 45% or more stability."
	]
	quest.1333C98733E8948C.quest_desc: [
		"Optional. The &eCopper Crusher Chassis&r is a Stage 2 sidegrade. It works faster and uses less &bFE&r than the Iron Crusher, but has a smaller &bFE&r buffer."
		""
		"&aBuild:&r"
		"- Craft a &eCopper Crusher Chassis&r."
		"- Optional: craft a &eCopper Crush Head&r. It has hardness 2, the same as the &eIron Crush Head&r."
	]
	quest.1333C98733E8948C.quest_subtitle: "Faster and more efficient, smaller buffer."
	quest.1333C98733E8948C.title: "Copper Crusher"
	quest.135EB1E2D3366D98.quest_desc: [
		"From now on, recipes need heat. A machine with enough heat can still fail when its heat control is poor."
		""
		"- Target temperature: each recipe has one. The machine waits until it reaches it."
		"- Max Temperature: the highest heat that the machine can reach. The Heat Core gives most of it."
		"- Temperature Stability: some recipes need a minimum. From Stage 4, a low value builds failure strain."
		"- Overheat Tolerance: gives more room above the safe maximum of a recipe."
		"- A hotter recipe can leave a machine above the safe range of the next recipe. The machine then cools down before it works."
		"- Overheat slider: on the Process tab, it sets how far above the target the machine runs. Hotter is faster, but each craft costs more FE."
		"- Blast Draft: this Mastery keystone lets the slider go above the safe maximum. Above its overheat temperature, a metal recipe can fail."
		"- Nitrogen: with Blast Draft, Nitrogen in an electric Furnace, Alloy Furnace, or Metal Press raises the overheat temperature. Nitrogen comes in Stage 6."
		""
		"&7&oNote: Heat Cores raise Max Temperature. Servos and Temperature Stability make the work safer.&r"
	]
	quest.135EB1E2D3366D98.quest_subtitle: "Recipes now need heat control."
	quest.1427760B7576D8D6.quest_desc: [
		"The &eSteel Crusher Chassis&r needs 3 &eInvar Ingots&r."
		"Invar is a direct alloy. The Alloy Furnace makes ingots, not a blend."
		""
		"&aBuild:&r"
		"1. Mine Nickel Ore with a &eSteel Pick Head&r. Nickel Ore has hardness 3."
		"2. Smelt the raw Nickel or Nickel Dust in a &eBronze Furnace&r. Nickel needs 1,100 °C and 0.95 Temperature Stability."
		"3. Insert 2 Iron Ingots, 1 &eNickel Ingot&r, and 1 Charcoal into the Bronze Alloy Furnace."
		"4. Wait for 2 &eInvar Ingots&r. The recipe needs 900 °C."
		""
		"&7&oNote: A Steel Alloy Furnace with a Steel Alloy Crucible and a Steel Heat Core reaches 1,100 °C. Its Invar recipe needs no Charcoal and makes 3 ingots.&r"
	]
	quest.1427760B7576D8D6.title: "Invar Alloy"
	quest.14A8140EBDA3865E.quest_desc: [
		"Optional. A &eDormant Machine&r is an old machine in a small ruin. It holds one Mastery soul."
		"Wake it with &bFE&r, then absorb the soul with a &eSoul Transfer&r."
		""
		"Each kind of site holds souls of some machine families and levels:"
		"- Collapsed Workshop, on dry land: Crusher, Furnace, or Metal Press, level 8 to 20"
		"- Abandoned Cart Siding, in a rail tunnel underground: Forestry Companion, level 10 to 25"
		"- Buried Calibration Vault, deep underground: Resonance Calibrator, level 20 to 40"
		"- Flooded Foundry, on the ocean floor: Alloy Furnace or Melter, level 25 to 45"
		"- Nether Smeltworks, in the Nether: Furnace, Alloy Furnace, or Melter, level 35 to 55"
		"- End Relay, on the outer End islands: Crusher, Resonance Calibrator, or Melter, level 40 to 70"
		""
		"{@pagebreak}"
		"&aUse:&r"
		"1. Insert up to 9 charged Battery Cells in its sockets. You can also supply FE on any side."
		"2. Fill the wake charge. A higher soul needs more FE. The machine then wakes and stays awake."
		"3. Use a &eSoul Transfer&r on the awake machine to absorb the soul."
		"4. Release the soul into a machine of the same family."
		""
		"The soul has all its points spent on a build and one free Full Reset. It has no ascendancy and no Seal tiers."
		""
		"A failed absorb uses up the Soul Transfer. By default, the machine keeps its soul, so you can try again."
		""
		"&7&oNote: The derelict Forestry Companion takes power only from the cells on its screen.&r"
		"&7&oNote: Dormant Machines have no owner. Another player can wake one and take its soul.&r"
	]
	quest.14A8140EBDA3865E.quest_subtitle: "Find old machines with a soul."
	quest.14A8140EBDA3865E.title: "Dormant Machines"
	quest.152F570B1A4F2B63.quest_desc: ["The &eAscension Catalyst&r makes a Magic item Rare and adds one affix. The item needs 5 RP or more. It costs 4 RP."]
	quest.17CCC098655F7B05.quest_desc: [
		"The &eSteel Solid Fuel Burner&r accepts Gear up to Stage 4 and has the highest stability."
		"Its recipe needs a &eCalibrated Thermal Component&r with 55 or more stability."
		"A &eSteel Heat Core&r gives 96 &bFE/t&r. A &eSteel Fuel Box&r also burns block fuels, such as Blocks of Coal."
	]
	quest.17E4A9571BBF913F.quest_desc: [
		"Calibrate a Diamond with an Emerald and the Logic Calibration Pattern. This Stage 6 recipe needs the Titanium Resonance Calibrator."
		""
		"The Stage 7 Calibrator chassis, the late Stabilizer Matrices, and the Ultimate Circuit Blank use this crystal."
	]
	quest.1B2846DF3677C5FF.quest_desc: [
		"&aUse:&r"
		"1. Sneak-use the &eConfigurator&r in the air to set it to Mastery mode."
		"2. Sneak-use a machine to copy its build."
		"3. Use the Configurator on a machine with the same start and an empty tree."
		""
		"The target machine buys the nodes that it can pay for now. It follows the build as it earns more points."
		"Machines that share a start can share builds: the Furnace with the Alloy Furnace, and the Metal Press with the Resonance Calibrator."
		""
		"&7&oNote: Shift-click &eCopy&r on the Mastery tab to save the build to a Configurator in your inventory.&r"
	]
	quest.1B2846DF3677C5FF.quest_subtitle: "One build, many machines."
	quest.1B2846DF3677C5FF.title: "Copy a Build"
	quest.1B2ED2616C7CD0DE.quest_desc: [
		"Look for &6Uniques&r in these places:"
		"- Village chests"
		"- Mineshaft minecart chests"
		"- Ruined portal chests"
		"- Igloo basement chests"
		"- Nether fortress chests"
		"- Bastion treasure chests"
		"- Ancient city chests"
		"- Ominous trial vaults"
		"- Witches that a player kills"
		""
		"&aUse:&r"
		"1. Put the unidentified Unique alone in a crafting grid."
		"2. Take the result to roll its stats."
		"3. Hold &eShift&r on the Unique to see the range and roll quality of each stat."
		""
		"&7&oNote: Install the Unique in a machine and hover over it there. The tooltip greys out the stats that the machine does not use.&r"
	]
	quest.1B2ED2616C7CD0DE.quest_subtitle: "Find one, then identify it."
	quest.1B2ED2616C7CD0DE.title: "First Unique"
	quest.1B81DECAE466F2D6.quest_desc: [
		"The &eWrench&r controls Cable links and shows connector settings. Craft it from 5 iron ingots."
		""
		"&aUse:&r"
		"- Right-click a cable arm to switch off the link to the next Cable."
		"- Right-click the side of the cable core to switch the link on again."
		"- Hold the Wrench and look at a Universal Connector to see its settings."
		"- Shift-right-click to show the next page of the settings."
		""
		"A red line under a connector or module shows that it cannot move anything. For example, no other connector uses its channel."
		""
		"&7&oNote: The Cycle Wrench View key also changes the page. It has no default binding.&r"
	]
	quest.1B81DECAE466F2D6.quest_subtitle: "See and control the network."
	quest.1B81DECAE466F2D6.title: "Wrench"
	quest.1F1BF8747340F867.quest_desc: ["Insert the &ePower Modifier Lens&r in the focus slot of the Affix Forge. It makes Power affixes 3 times as likely."]
	quest.1FACE973E783CB4C.quest_desc: [
		"Most Stage 3 and higher machines need calibrated components. The &eResonance Calibrator&r makes them from plates, gears, coils, and circuits."
		""
		"&aBuild:&r"
		"1. Place an &eIron Resonance Calibrator Chassis&r."
		"2. Install an &eIron Resonance Coil&r and an &eIron Control Board&r. Both are required."
		"3. Install a Calibration Pattern and select it."
		"4. Insert the input and its catalyst."
		"5. Supply &bFE&r."
		""
		"&aUse:&r"
		"- The Calibrator rolls the stability of each component when it makes it."
		"- Quality raises the low and the high rolls."
		"- Stability raises the low rolls."
		"- Precision makes the roll range narrower."
		"- A Battery Cell prevents the no-cell quality penalty."
		"- Look for &eHarmonic&r (quality), &eExacting&r (precision), and &eAnchoring&r (stability) affixes on the Calibrator and its Gear."
		""
		"&7&oNote: Recycle a low roll in the Component Recycler to get the raw input back.&r"
	]
	quest.1FACE973E783CB4C.quest_subtitle: "Calibrated parts for the midgame."
	quest.1FACE973E783CB4C.title: "Calibration Needed"
	quest.20200D3111A76F09.quest_desc: ["The &eExpansion Crystal&r adds affixes until all empty slots are full or the RP runs out. A Normal item becomes Magic."]
	quest.2092E4A1CA217B5D.quest_desc: ["The &eNullite Servo&r has half Processing Speed. Its Auto Purge lets fluid machines void extra output fluid, so they do not stop."]
	quest.22A86431ABEC9DD3.quest_desc: [
		"With nitrogen Gear, the &eCavitation Generator&r splits &bWater&r into &bNitrogen&r. Each cycle makes 1,000 mB of Nitrogen and much less FE."
		""
		"&aBuild:&r"
		"1. Craft a &eNitrogen Extraction Rotor&r. It needs a Cavitation Rotor Hub with 35 or more stability and a Reforming Catalyst Bed."
		"2. Craft a &eNitrogen Separation Nozzle&r."
		"3. Install the rotor and the nozzle in a &eCavitation Generator&r."
		""
		"&aUse:&r"
		"- Fill the tank with &bWater&r."
		"- Extract &bNitrogen&r through pipes from any side."
		"- Move the Nitrogen to the &eAmmonia Synthesizer&r."
		"- Or supply it to an electric Furnace, an Alloy Furnace, or a Metal Press with the Blast Draft keystone."
		""
		"One generator makes Nitrogen for two or three Synthesizers."
		""
		"With Blast Draft, Nitrogen in a heated machine gives 15% increased Overheat Tolerance. Each lane above its normal overheat temperature uses 1 mB each tick."
		""
		"&7&oNote: The generator stops when the 8,000 mB Nitrogen tank is full. A Nullite Servo voids the extra Nitrogen.&r"
	]
	quest.22A86431ABEC9DD3.quest_subtitle: "Split Water into Nitrogen."
	quest.22A86431ABEC9DD3.title: "Nitrogen Production"
	quest.23011878EBC32FC2.quest_desc: [
		"The &eIron Battery Chassis&r holds 1 cell. It is simple and reliable, and it does not leak."
		"Its affixes apply strongly to its one cell."
	]
	quest.2395BFD1C7ACB809.quest_desc: [
		"&aBuild:&r"
		"1. Calibrate a &eSparksteel Coil&r in a Steel or better Resonance Calibrator. You get a Stage 5 Calibrated Conductive Component."
		"2. Craft the Seal from the component and a &ePrimed Seal Core&r."
		"3. Add 4 &eSparksteel Plates&r, 2 &eAluminum Casings&r, and 1 &eAdvanced Electric Circuit&r."
		""
		"The component needs 70% or more stability. A second recipe accepts 2 components with 55% or more stability. It uses a Stabilizer Matrix and 3 Sparksteel Plates, and no circuit."
		""
		"&aUse:&r"
		"- Use the Seal on a machine that you want to keep. The ascendancy stays with that machine."
		""
		"&7&oNote: A &eSoul Transfer&r moves the ascendancy and Seal tiers to another machine of the same kind.&r"
	]
	quest.2395BFD1C7ACB809.quest_subtitle: "Choose a path."
	quest.2395BFD1C7ACB809.title: "Ascendancy Seal I"
	quest.2A87820D10501CE9.quest_desc: [
		"Optional. Each Solid Fuel Burner accepts Gear up to its own stage."
		"A better Heat Core gives more &bFE/t&r and burns higher fuel tiers."
	]
	quest.2AB169CEEBB9FA40.quest_desc: [
		"A new chassis starts at level 1. A &eSoul Transfer&r moves all the Mastery of a machine to another machine of the same kind."
		"The soul keeps XP, level, tree, ascendancy, and Seal tiers."
		""
		"&aBuild:&r"
		"1. Calibrate a Basic Electric Circuit into a &eCalibrated Logic Component&r with the Logic Calibration Pattern."
		"2. Craft the Soul Transfer from a diamond, 2 gold ingots, an amethyst shard, and the component."
		""
		"The component must be Stage 2 or higher. A component from a Basic Electric Circuit is Stage 2."
		""
		"&aUse:&r"
		"1. Use the Soul Transfer on the old machine to absorb its soul. The old machine goes back to level 1."
		"2. Use the Soul Transfer on the new machine to release the soul."
		""
		"The success chance of the absorb is the stability of the Calibrated Logic Component. A failed absorb uses up the Soul Transfer, and the machine keeps its Mastery."
		""
		"&7&oNote: A soul with an ascendancy needs a Stage 4 or higher machine. A Furnace soul cannot go into an Alloy Furnace.&r"
		"&7&oNote: If the new machine has Mastery, the first use only warns you. Sneak-use to release the soul anyway.&r"
		"&7&oNote: An Annealed Basic Electric Circuit calibrates with better stability. This gives a safer Soul Transfer.&r"
	]
	quest.2AB169CEEBB9FA40.quest_subtitle: "Move Mastery to a better machine."
	quest.2AB169CEEBB9FA40.title: "Soul Transfer"
	quest.2B8333FC1B90FDF8.title: "READ: You"
	quest.2C5B42CFDFA5C13B.quest_desc: [
		"The &eAluminum Compressor Tank&r stores 64,000 mB loose and 1,024,000 mB compressed. It accepts Gear up to Stage 5."
		"Craft it from a &ePressure Tank Frame&r, 4 glass, and 4 aluminum ingots."
	]
	quest.2C5B42CFDFA5C13B.quest_subtitle: "The Stage 5 Compressor Tank."
	quest.2C5B42CFDFA5C13B.title: "Aluminum Compressor Tank"
	quest.2C865B9D41D7EEBB.quest_desc: [
		"A &eDiamond Tip&r raises a &eSteel Pick Head&r or &eSteel Hammer Head&r from ore hardness 3 to 4. The head can be loose or in a tool."
		""
		"&aBuild:&r"
		"- Craft a &eDiamond Tip&r from a Diamond and a &eSteel Plate&r."
		""
		"&aUse:&r"
		"1. Put the Steel head or the tool in the &eTool Bench&r."
		"2. Put the &eDiamond Tip&r in the repair slot."
		"3. Click Apply."
		""
		"&7&oNote: The Tool Bench uses up the tip.&r"
	]
	quest.2C865B9D41D7EEBB.quest_subtitle: "Raise a Steel head to hardness 4."
	quest.2DD5120E11128BFD.quest_desc: [
		"The &eBronze Alloy Furnace Chassis&r mixes exact amounts of metals and carbon into alloys."
		"With a &eBronze Heat Core&r, it reaches 900 °C. Every alloy needs at least 900 °C."
		""
		"There are two Steel Blend recipes. Use the 900 °C recipe with Iron Dust, Coal, and Charcoal. The other recipe needs 1,100 °C."
		""
		"&aBuild:&r"
		"1. Craft a &eBronze Alloy Furnace Chassis&r. Its recipe uses 2 &eBronze Heat Cores&r."
		"2. Install a &eBronze Heat Core&r."
		"3. Install a &eBronze Alloy Crucible&r. The machine needs a crucible to work."
		"4. Install a Battery Cell. Without a cell, the machine is slower and less stable."
		""
		"&7&oNote: Every item in the input slots must belong to the recipe. One wrong item stops the machine.&r"
	]
	quest.2DD5120E11128BFD.quest_subtitle: "Mix metals and carbon into alloys."
	quest.2DD5120E11128BFD.title: "Alloy Furnace"
	quest.301EC3DBE0E3AFE6.quest_desc: ["You need to be able to make electric circuit to advance into stage 3 and 4."]
	quest.3034E1FAD40A48B2.quest_desc: [
		"&6Uniques&r are Gear parts and Battery Cells that you find. You cannot craft them. A Unique has an orange-brown name."
		""
		"Each Unique has a signature effect and a drawback that you can see on the item. Some Uniques also have an ascendancy bonus. It works only on a machine with that ascendancy."
		""
		"All copies of a Unique have the same stat lines. Each copy rolls its own values inside the ranges on the item."
		""
		"Uniques have no Refinement Potential. You cannot refine or recycle them. Only a &eVolatile Catalyst&r can change a Unique."
	]
	quest.3034E1FAD40A48B2.quest_subtitle: "Uniques are sidegrades that you find."
	quest.3034E1FAD40A48B2.title: "Read: Uniques"
	quest.321FEE7AFB102523.quest_desc: [
		"The &eAlloy Solid Fuel Burner&r accepts Gear up to Stage 3. Its Fuel Reserve keeps the last fuel item in the slot."
		"Its recipe needs a &eCalibrated Thermal Component&r with 45 or more stability."
		"A &eBronze Heat Core&r gives 64 &bFE/t&r and loses no heat."
	]
	quest.3371D7F8EE64B366.quest_desc: [
		"A &ePhase Coil&r is one position of the Phase Array line. Three to nine Coils and a Phase Emitter in a row from the Phase Cradle make a line; inscribe a Glyph into each Coil to open its position."
		""
		"- Refine All: reroll the value of every affix."
		"- Refine Selected: reroll the value of one affix."
		"- Remove Selected: remove one rolled affix."
		"- Add Modifier: add an affix to an empty slot."
		"- Upgrade Random: upgrade one random affix."
		"- Reforge: reroll the whole item and its Refinement Potential."
		""
		"&7&oNote: A power failure stops the operation, but you keep the item, the catalysts, and the Refinement Potential.&r"
	]
	quest.3371D7F8EE64B366.quest_subtitle: "One position of the Phase Array line."
	quest.3371D7F8EE64B366.title: "Phase Coil"
	quest.36290C98154741A7.quest_desc: [
		"Optional. The &eAmmonia Synthesizer&r also makes &eUrea&r, a fertilizer, from &bAmmonia&r and &bCarbon Exhaust&r."
		""
		"&aUse:&r"
		"1. Supply &bCarbon Exhaust&r to the Carbon Exhaust tank of an &eAmmonia Synthesizer&r."
		"2. Make sure that the Synthesizer has &bAmmonia&r in its Ammonia tank."
		"3. Extract the Urea from the Urea slot on the Process tab, or from the bottom or the sides."
		""
		"Each Urea uses 250 mB of Ammonia, 250 mB of Carbon Exhaust, and 3,000 FE in 120 ticks."
		"The Synthesizer makes Urea before Ammonia when both tanks hold enough. When the Urea slot is full, it makes Ammonia again."
		""
		"Urea has these uses:"
		"- Use Urea on a plant as bone meal. A dispenser can also use it."
		"- The Forestry Companion and its station accept Urea where they accept bone meal. Each Urea counts as 4 bone meal."
		"- Insert Urea in the Urea slot of an &eAlgae Photobioreactor&r. The next 4 Algae Biomass grow at twice the speed."
		""
		"&7&oNote: Each Urea uses Ammonia that can make 54,000 FE in a Fuel Cell. Make only the Urea that you need.&r"
	]
	quest.36290C98154741A7.quest_subtitle: "Make fertilizer from Ammonia and Carbon Exhaust."
	quest.36290C98154741A7.title: "Urea"
	quest.366307DF419BEB06.quest_desc: [
		"Optional. The &eSolar Array Controller&r collects the &bFE&r of connected panels around it. It exports the total from one block."
		""
		"&aBuild:&r"
		"1. Place the controller on the same level as your panels."
		"2. Place panels in the 3x3 area around it. Each panel must touch another panel or the controller."
		"3. Optional: install a Battery Cell for more storage."
		""
		"&aUse:&r"
		"- At range 1, the controller collects up to 8 panels."
		"- When every spot in range holds a panel of the same stage, the array gets 20% more output."
		"- Use the button on the Process tab to show the range in the world."
		""
		"&7&oNote: Range affixes and a Solar Array Extender raise the range to 2, a 5x5 area.&r"
	]
	quest.366307DF419BEB06.quest_subtitle: "One output for a field of panels."
	quest.366307DF419BEB06.title: "Solar Array"
	quest.36FD86C58309204A.quest_desc: ["Insert the &eEfficiency Modifier Lens&r in the focus slot of the Affix Forge. It makes efficiency affixes 3 times as likely."]
	quest.37A6C9E1284B5D10.quest_desc: [
		"&6RNGTech&r adds RPG elements to tech machines. Machines, Gear, tool parts, and Battery Cells roll their own rarity and affixes."
		""
		"Progress goes through 9 stages, from Stage 0 to Stage 8. Each stage adds new materials, machines, and problems."
		""
		"- Stage 0-2: Flint tools, the first &bFE&r, the first &eCrusher&r, and more ingots from each ore."
		"- Stage 3-4: Bronze and Steel, circuits, heat, and stability. From Stage 4, a machine can fail a job."
		"- Stage 5-6: Fluids and gases, such as &bSyngas&r, &bLubricant&r, &bHydrogen&r, and &bAmmonia&r."
		"- Stage 7-8: Permanent infrastructure for high &bFE/t&r, exotic materials, and the &ePhase Array&r."
	]
	quest.37A6C9E1284B5D10.quest_subtitle: "Machines are built in layers."
	quest.37A6C9E1284B5D10.title: "&6RNGTech&r - Read This First"
	quest.37A6C9E1284B5D11.quest_desc: [
		"In RNGTech, a machine is like an RPG character. You install Gear in the machine to change what it can do."
		""
		"- &eChassis&r: the placed machine block. It sets the base stats and the highest Gear stage that fits."
		"- &eBattery Cells&r: Gear that stores &bFE&r and sets how fast the machine takes in &bFE&r. Most machines run slower without one."
		"- &eCrush Heads&r: set how hard an ore a &eCrusher&r can process."
		"- &eHeat Cores&r: set the temperature of a &eFurnace&r or &eMetal Press&r."
		"- Later stages add more Gear, such as &eServos&r and &eFluid Pumps&r."
		""
		"&7&oNote: When a machine works badly, check its Gear before you replace the machine.&r"
	]
	quest.37A6C9E1284B5D11.quest_subtitle: "Each part has its own job."
	quest.37A6C9E1284B5D11.title: "Read: Component Roles"
	quest.37A6C9E1284B5D12.quest_desc: [
		"Most RNGTech machines, Gear parts, and Battery Cells roll a rarity, affixes, and Refinement Potential (RP) when you craft them."
		"Affixes change stats such as speed, output amount, efficiency, stability, transfer, or capacity."
		""
		"- Normal items have no affixes."
		"- Magic items have 1 prefix and 1 suffix."
		"- Rare items have up to 3 prefixes and 3 suffixes."
		""
		"A new item is Unidentified. Put it alone in a crafting grid to identify it. A machine also rolls its traits when you place it."
		""
		"Each successful refinement spends RP. When an item has no RP left, the Affix Forge cannot refine it. The quests in this chapter show each way to change affixes."
	]
	quest.37A6C9E1284B5D12.quest_subtitle: "Each crafted item rolls its own stats."
	quest.37A6C9E1284B5D12.title: "Read: Affixes"
	quest.37A6C9E1284B5D13.quest_desc: [
		"Many tool heads and machine parts need plates. Early in the game, you make plates with a &eForming Hammer&r."
		""
		"&aBuild:&r"
		"- Craft a &eForming Hammer&r."
		"- Put the &eForming Hammer&r and 4 &eIron Ingots&r in a crafting grid to craft 2 &eIron Plates&r."
		"- Use 4 &eCopper Ingots&r the same way to craft 2 &eCopper Plates&r."
		""
		"&7&oNote: Each plate craft uses 1 durability of the Forming Hammer. Later, the Metal Press makes plates.&r"
	]
	quest.37A6C9E1284B5D13.quest_subtitle: "Make your first plates by hand."
	quest.37A6C9E1284B5D13.title: "Forming Hammer"
	quest.37A6C9E1284B5D14.quest_desc: [
		"&eBattery Cells&r are Gear. A cell stores &bFE&r inside a machine and sets how fast the machine takes in &bFE&r."
		"Most machines work more slowly or make less output without a cell."
		""
		"&aBuild:&r"
		"- Craft an &eIron Battery Cell&r."
		""
		"&aUse:&r"
		"- Install the cell in the Gear tab of a machine."
		""
		"&7&oNote: An Iron Battery Cell stores 10,000 FE and gives out up to 64 FE/t.&r"
	]
	quest.37A6C9E1284B5D14.quest_subtitle: "A Battery Cell stores FE in a machine."
	quest.37A6C9E1284B5D14.title: "Serious First Cell"
	quest.37A6C9E1284B5D15.quest_desc: [
		"Optional. These Stage 0 parts work, but they are weak. Do not build your main factory on them."
		""
		"&aBuild:&r"
		"- Craft a &ePotato Battery Cell&r."
		"- Craft a &eWooden Battery Chassis&r."
		"- Craft a &eWooden Crusher Chassis&r."
		""
		"&aUse:&r"
		"- The &ePotato Battery Cell&r stores 1,000 &bFE&r. In a Battery Chassis, it loses 12% of its charge each minute."
		"- The &eWooden Battery Chassis&r holds 1 cell. It leaks &bFE&r and wastes some of the &bFE&r that it receives."
		"- The &eWooden Crusher Chassis&r accepts only a &eFlint Crush Head&r, which has hardness 1."
		"- Raw metal and ore need hardness 2. The Wooden Crusher crushes them slowly and gives no bonus output."
	]
	quest.37A6C9E1284B5D15.quest_subtitle: "Stage 0 novelties. They work, but badly."
	quest.37A6C9E1284B5D15.title: "Silly Power"
	quest.37A6C9E1284B5D16.quest_desc: [
		"In Stage 1-2, you make your first &bFE&r and get more than 1 ingot from each ore."
		"Early machines push &bFE&r into the machines that touch them. You do not need cables yet."
		""
		"1. Craft a &eMachine Frame&r and an &eIron Battery Cell&r."
		"2. Place a &eCrude Solid Fuel Burner&r."
		"3. Place an &eIron Crusher Chassis&r next to the burner."
		"4. Crush raw metal, then smelt the output in the &eFurnace&r."
		""
		"&7&oNote: When a machine works badly, check its Gear first.&r"
	]
	quest.37A6C9E1284B5D16.quest_subtitle: "First power, then more ingots per ore."
	quest.37A6C9E1284B5D16.title: "Read: Factory Start"
	quest.37A6C9E1284B5D17.quest_desc: [
		"The &eIron Crusher Chassis&r breaks raw metal and ore into crushed material. Each crushed item smelts into 1 ingot, so 1 raw metal gives 2 ingots instead of 1."
		""
		"&aBuild:&r"
		"1. Place an &eIron Crusher Chassis&r next to the burner."
		"2. Install an &eIron Crush Head&r in the Gear tab."
		"3. Install a Battery Cell."
		""
		"&aUse:&r"
		"- Insert raw metal or ore from the top."
		"- Extract the output from the bottom."
		"- The Crusher accepts &bFE&r on any side."
		""
		"&7&oNote: The Iron Crush Head has hardness 2. A harder recipe takes more time and FE for each level above the head. It can also jam and gives no bonus output.&r"
	]
	quest.37A6C9E1284B5D17.quest_subtitle: "The Crush Head sets the hardness."
	quest.37A6C9E1284B5D17.title: "Iron Crusher"
	quest.37A6C9E1284B5D18.quest_desc: [
		"Crush ore before you smelt it."
		"- A raw metal item gives 2 crushed material."
		"- An ore block gives 3 crushed material."
		""
		"The Crusher can also give extra output:"
		"- &eBonus Output&r is a fixed extra share. Each craft adds its share to a bar. When the bar is full, you get 1 extra item."
		"- &eSuper Output&r is a separate chance for 1 extra copy of the output. On a Crusher, it stops at 25%."
		"- Only the first crush gets these bonuses. The dust pass and ingot recipes never get them."
		"- Without a Battery Cell, the Crusher keeps only 75% of its bonus above 1x."
		""
		"&aBuild:&r"
		"- Collect &eCrushed Iron&r and &eCrushed Copper&r."
		""
		"&7&oNote: The bonus bar resets when you change the input item. Keep one input type in each Crusher.&r"
	]
	quest.37A6C9E1284B5D18.quest_subtitle: "Get more metal from each ore."
	quest.37A6C9E1284B5D18.title: "Ore Multiplication"
	quest.37A6C9E1284B5D19.quest_desc: [
		"The RNGTech &eFurnace&r burns normal furnace fuel. It reaches 800 °C, which is enough for Iron and Copper."
		"Each recipe has a target temperature. The Furnace heats up first and starts to smelt at that temperature."
		""
		"&aBuild:&r"
		"- Craft a &eFurnace&r."
		""
		"&aUse:&r"
		"- Insert fuel from the sides."
		"- Insert crushed material or dust from the top."
		"- Extract ingots from the bottom."
		""
		"&7&oNote: Efficiency, Fuel Efficiency, and Fuel Duration make each fuel item burn longer. Electric Furnaces come in Stage 3-4, after circuits.&r"
	]
	quest.37A6C9E1284B5D19.quest_subtitle: "A fuel furnace that reaches 800 °C."
	quest.37A6C9E1284B5D19.title: "Hotter Furnace"
	quest.37A6C9E1284B5D1A.quest_desc: [
		"&eCable&r carries &bFE&r, fluids, and items between machines. The Cable stores nothing."
		"A &eUniversal Connector&r beside each machine controls what moves, in which direction, and how fast."
		""
		"The tier of each connector module sets its transfer rate. To move more, install a better module. You do not replace the Cable."
		""
		"&aBuild:&r"
		"1. Craft &eCable&r. One craft makes 12."
		"2. Place the Cable next to your machines. Cables that touch link together."
		"3. Use a &eUniversal Connector&r on the Cable face beside a machine."
		"4. Right-click the connector with an empty hand to open it."
		"5. Install connector modules in its Energy, Fluid, and Item tabs."
		""
		"&7&oNote: The &eCrude Energy Connector&r is the only module that you can craft by hand. The Metal Press makes the other modules.&r"
		""
		"{@pagebreak}"
		"&aUse:&r"
		"- Set the same channel on all modules that must exchange FE, fluid, or items."
		"- Use channels 0 to 15. Energy, Fluid, Item, and Bridge channels are separate."
		"- Set Attach As to select which machine side the connector acts as."
		"- Set Distribution on the Energy tab to select how the connector splits FE between outputs."
		"- Open the Network tab to see the cables, connectors, channels, and FE flow of the network."
		""
		"All connections are many-to-many. One channel can move water and &bCarbon Exhaust&r to many &eAlgae Photobioreactors&r."
		""
		"Each tick, the network shares FE fairly. Generators supply machines first, spare FE charges storage blocks, and storage blocks then supply machines."
		""
		"&7&oNote: Dye Cables to keep two parallel lines in separate networks. Undyed Cable links to all colors.&r"
		""
		"{@pagebreak}"
		"Words on the connector screen:"
		"- Network: all Cables that touch and link together."
		"- Row: one Fluid or Item module slot with its own mode, channel, and Attach As. The Fluid and Item tabs have 3 rows each."
		"- Energy slot: the Energy tab has 1 module slot."
		"- Channel: a separate link inside the network. Only modules on the same channel exchange anything."
	]
	quest.37A6C9E1284B5D1A.quest_subtitle: "One cable carries FE, fluids, and items."
	quest.37A6C9E1284B5D1A.title: "Cable Backbone"
	quest.37A6C9E1284B5D1B.quest_desc: [
		"In Stage 3-4, resources and power get harder. The goal is a factory of Steel machines that you keep for a long time."
		""
		"- Recipes need a target temperature. The Heat Core sets how hot a machine gets."
		"- Machines need a steady supply of &bFE&r."
		"- From Stage 4, a machine can fail a job when its heat, stability, or power is not correct."
		""
		"&7&oNote: Use Stage 4 machines for the lines that you want to keep.&r"
	]
	quest.37A6C9E1284B5D1B.quest_subtitle: "Heat, steady power, and the first failures."
	quest.37A6C9E1284B5D1B.title: "Stage 3-4: Stability"
	quest.37A6C9E1284B5D1C.quest_desc: [
		"The &eCrude Solid Fuel Burner&r is your first real &bFE&r source. It burns coal, charcoal, planks, and other furnace fuels."
		"The burner needs all 3 Gear parts before it burns fuel. With an &eIron Heat Core&r, it makes 24 &bFE/t&r."
		""
		"&aBuild:&r"
		"1. Place a &eCrude Solid Fuel Burner&r."
		"2. Install an &eIron Heat Core&r in the Gear tab."
		"3. Install an &eIron Fuel Box&r."
		"4. Install the &eIron Battery Cell&r from the previous quest."
		""
		"&aUse:&r"
		"- Insert fuel in the fuel slot on the Process tab."
		"- The burner pushes &bFE&r into adjacent machines and cables."
		"- Set the stoke on the Process tab, from 25% to 100%."
		"- A lower stoke gives less &bFE/t&r, but more &bFE&r from each fuel item."
		""
		"&7&oNote: The Crude burner accepts only Stage 1 Gear. Logs burn for only 1/4 of their furnace time, so craft them into planks.&r"
		"&7&oNote: The Iron Fuel Box has no Fuel Governor. It continues to burn fuel when the cell is full, and that fuel is lost.&r"
	]
	quest.37A6C9E1284B5D1C.quest_subtitle: "Burn fuel to make FE."
	quest.37A6C9E1284B5D1C.title: "Crude FE Burner"
	quest.37A6C9E1284B5D1D.quest_desc: [
		"Optional path. The &eCopper Battery Chassis&r trades some stability for better early transfer and small burst behavior."
		""
		"&aBuild:&r"
		"- Place a &eCopper Battery Chassis&r."
		"- Install a &eCopper Battery Cell&r."
		""
		"&aUse:&r"
		"- Use this path for early lines that need more &bFE/t&r than Iron can move."
		"- Watch leakage and low stability before scaling it."
	]
	quest.37A6C9E1284B5D1D.quest_subtitle: "Transfer now, stability later."
	quest.37A6C9E1284B5D1D.title: "Copper Bus"
	quest.37A6C9E1284B5D1F.quest_desc: [
		"The &eAffix Forge&r adds, upgrades, rerolls, and removes the affixes of an item. It needs no power."
		""
		"&aBuild:&r"
		"- Craft an &eAffix Forge&r and place it."
		""
		"&aUse:&r"
		"1. Insert the item in the target slot."
		"2. Insert a catalyst in the catalyst slot. The outcome panel shows the result and the RP cost."
		"3. Click &eReforge&r."
		""
		"Without upgrades, the forge accepts the &eAffix Injector&r, &eAffix Upgrader&r, and &eNullifier Coil&r. Three upgrades unlock lenses, modifier crystals, and stronger catalysts."
		""
		"&7&oNote: The forge refines items only. To refine a placed machine, use the Refinement tab of that machine.&r"
		"&7&oNote: A failed or illegal operation uses no catalyst and no RP.&r"
	]
	quest.37A6C9E1284B5D1F.quest_subtitle: "Change the affixes of an item."
	quest.37A6C9E1284B5D1F.title: "Affix Forge"
	quest.37A6C9E1284B5D20.quest_desc: [
		"RNGTech has two recovery machines. They recover different value."
		""
		"- The &ePotential Reactor&r turns the rarity, affixes, and unspent Refinement Potential of an item into &bFE&r."
		"- The &eComponent Recycler&r returns some crafting materials from components and machines."
		""
		"&7&oNote: Burn a rolled item in the Potential Reactor first. Then recycle the stripped item in the Component Recycler.&r"
	]
	quest.37A6C9E1284B5D20.quest_subtitle: "Old parts still have value."
	quest.37A6C9E1284B5D20.title: "Read: Recycling Path"
	quest.37A6C9E1284B5D21.quest_desc: [
		"Optional. The &ePotential Reactor&r burns old rolled Gear, machines, and Battery Cells for &bFE&r. It pays for rarity, affixes, and unspent Refinement Potential."
		""
		"&aBuild:&r"
		"1. Place a &ePotential Reactor&r."
		"2. Install an &eIron Reactor Chamber&r. The reactor needs a chamber to work."
		"3. Optional: install an &eIron Recovery Filter&r. It returns residue from salvage fuel."
		"4. Optional: install an &eIron Containment Lining&r. It raises stability, which gives more &bFE&r."
		""
		"&aUse:&r"
		"- Insert items from the top."
		"- Extract stripped items and residue from the bottom."
		"- The reactor pushes &bFE&r out of its four sides."
		""
		"&7&oNote: Each repeat of the same item type pays 25% less. Burn many different items.&r"
	]
	quest.37A6C9E1284B5D21.quest_subtitle: "Recover value before teardown."
	quest.37A6C9E1284B5D21.title: "Potential Reactor"
	quest.37A6C9E1284B5D22.quest_desc: [
		"Optional. The &eComponent Recycler&r returns some crafting materials from machines, Gear, and calibrated components."
		""
		"&aBuild:&r"
		"1. Place an &eIron Component Recycler&r."
		"2. Install an &eIron Disassembly Head&r."
		""
		"&aUse:&r"
		"- Insert items from the top."
		"- Extract the returns from the bottom."
		"- Supply &bFE&r on the sides."
		"- The Recycler stage and the processing level of the head must both reach the level of the recipe."
		""
		"&7&oNote: The Recycler ignores affixes and Refinement Potential. Burn rolled items in the Potential Reactor first.&r"
		"&7&oNote: A calibrated component returns its raw ingredient. Recycle a low roll and calibrate it again.&r"
	]
	quest.37A6C9E1284B5D22.quest_subtitle: "Get materials back from old parts."
	quest.37A6C9E1284B5D22.title: "Component Recycler"
	quest.37A6C9E1284B5D23.quest_desc: [
		"Stage 4 adds failures. A Stage 4 or higher machine can fail a job on a recipe that has a failure output."
		""
		"Failure strain builds up when:"
		"- The heat is too low, or above the safe maximum of the recipe."
		"- The Temperature Stability is too low."
		"- The &bFE&r supply drops during a power-sensitive job."
		""
		"When the strain is full, the input becomes a failure item, such as a &eMalformed Ingot&r or a &eBroken Circuit&r."
		""
		"On any Furnace, a metal smelt can also fail when you push it above its overheat temperature with the overheat slider."
		""
		"&aUse:&r"
		"- Smelt a &eMalformed Ingot&r in a Furnace to get 2 nuggets back."
		"- Keep a Battery Cell in each machine and keep the &bFE&r supply steady."
		""
		"&7&oNote: Servos and Battery Cells make the same work safer.&r"
	]
	quest.37A6C9E1284B5D23.quest_subtitle: "Control before speed."
	quest.37A6C9E1284B5D23.title: "Stable Power"
	quest.37A6C9E1284B5D24.quest_desc: [
		"The &eMetal Press&r is faster than the Crude press and has better base stats. It can fail a job and make a failure item."
		""
		"&aBuild:&r"
		"1. Craft a &eSteel Servo&r."
		"2. Install the Servo and a &ePlate Mold&r in the &eCrude Metal Press&r."
		"3. Press 4 &eSteel Plates&r."
		"4. Craft the &eMetal Press&r. Its recipe also uses a Steel Servo."
		"5. Install a Heat Core, a Steel Servo, and a mold in the Metal Press."
		""
		"&aUse:&r"
		"- The Metal Press needs a Servo to work."
		"- Keep the Crude press for slow work that cannot fail."
		""
		"&7&oNote: Steel Plates need 1.0 Temperature Stability. A Crude press with a Bronze Heat Core needs a Steel Servo to reach it.&r"
	]
	quest.37A6C9E1284B5D24.quest_subtitle: "A faster press that can fail."
	quest.37A6C9E1284B5D24.title: "Steel Metal Press"
	quest.37A6C9E1284B5D25.quest_desc: [
		"Steel machines are the base of the Stage 4 factory. Build the machines that you want to keep for a long time."
		""
		"&aBuild:&r"
		"1. Craft a &eSteel Crusher Chassis&r. Its recipe needs 3 &eInvar Ingots&r and a &eCalibrated Kinetic Component&r with 55 or more stability."
		"2. Craft a &eSteel Furnace Chassis&r. Its recipe needs an &eAdvanced Electric Circuit&r and a &eCalibrated Thermal Component&r with 55 or more stability."
		"3. Craft a &eSteel Battery Chassis&r. Its recipe needs a &eCalibrated Storage Component&r with 55 or more stability."
		"4. Craft a &eSteel Crush Head&r. It has hardness 4."
		""
		"&aUse:&r"
		"- The Steel Crusher has Output Guard. It keeps its progress for a time when the output slot is full."
		"- Keep the best rolled parts for your long-term lines."
	]
	quest.37A6C9E1284B5D25.quest_subtitle: "Move the main factory to Steel."
	quest.37A6C9E1284B5D25.title: "Steel Factory Ready"
	quest.37A6C9E1284B5D26.quest_desc: [
		"Stages 5 and 6 add gas power and fluid chemistry. Most machines in this chapter use fluids and gases."
		""
		"- The &eCoal Gasifier&r and the &eSyngas Combustor&r make Stage 5 power from coal."
		"- The &eMelter&r makes &bLubricant&r, &bElectrolyte Solution&r, and &bMethane&r."
		"- The &eSteam Methane Reformer&r makes &bHydrogen&r from &bMethane&r."
		"- The &eFuel Cell&r makes Stage 6 power from &bAmmonia&r."
		"- Titanium and higher Servos need &bLubricant&r."
		""
		"Most quests in this chapter are optional. The Melter quest and the Titanium Furnace Set quest open the Stage 7+ chapter."
		""
		"&7&oNote: Stage 5 and higher recipes use much more FE. Build more power before you continue.&r"
	]
	quest.37A6C9E1284B5D26.quest_subtitle: "Gas power and fluid chemistry."
	quest.37A6C9E1284B5D26.title: "Stage 5-6: Fluids and Chemistry"
	quest.37A6C9E1284B5D27.quest_desc: [
		"The &eMelter&r is a Stage 6 machine. It melts two items in a fluid, usually &bWater&r, to make a new fluid."
		""
		"&aBuild:&r"
		"1. Craft a &eMelter&r. The recipe needs Titanium parts and a calibrated Sparksteel Coil with 70 or more stability."
		"2. Install a Heat Core that reaches 1,200 °C or more."
		"3. Install a Crush Head with hardness 6 or more, such as a &eTitanium Crush Head&r."
		"4. Install a &eFluid Pump&r. Without a pump, the Melter cannot output fluid."
		""
		"&aUse:&r"
		"- Insert a lubricant base, such as &eResin&r, and an additive, such as &ePlant Reagent&r."
		"- Fill the input tank with &bWater&r."
		"- Supply &bFE&r."
		"- Fill buckets in the output container slot, or extract &bLubricant&r from the sides."
		""
		"&7&oNote: The bases are Resin, Rubber, Slime Balls, and Honey Bottles. The additives are Plant Reagent and Organic Reagent.&r"
	]
	quest.37A6C9E1284B5D27.quest_subtitle: "The Melter turns items into fluids."
	quest.37A6C9E1284B5D27.title: "Melter and Lubricant"
	quest.37A6C9E1284B5D28.quest_desc: [
		"A &eFluid Pump&r lets the &eMelter&r fill containers and send fluid out of its sides. A better pump moves fluid faster."
		""
		"- &eOsmium Fluid Pump&r: Stage 5, 125 mB/t"
		"- &eTitanium Fluid Pump&r: Stage 6, 250 mB/t"
		"- &eTungstensteel Fluid Pump&r: Stage 7, 500 mB/t"
		"- &eExotic Fluid Pump&r: Stage 8, 1,000 mB/t"
		""
		"&eServos&r add Processing Speed, Stability, Temperature Stability, and Overheat Tolerance. Titanium and higher Servos need &bLubricant&r to craft."
	]
	quest.37A6C9E1284B5D28.quest_subtitle: "Gear for fluid output and control."
	quest.37A6C9E1284B5D28.title: "Pumps and Servos"
	quest.37A6C9E1284B5D2D.quest_desc: [
		"Stages 7 and 8 add the Tungstensteel, Nullite, Aethergold, and Exotic machine sets. The &eVacuum Collapse Generator&r is the Stage 7 power source."
		""
		"Stage 7 and 8 items roll 22 to 32 Refinement Potential. Tier 7 affixes appear only on Stage 8 Exotic items."
		""
		"Late recipes need more heat, Temperature Stability, and calibrated components with high stability. Check the affixes on your Gear before you craft."
	]
	quest.37A6C9E1284B5D2D.quest_subtitle: "Late machine sets and Stage 7 power."
	quest.37A6C9E1284B5D2D.title: "Stage 7+: Infrastructure"
	quest.37A6C9E1284B5D2E.quest_desc: [
		"The &eTungstensteel Crusher&r crushes up to 4 items in each cycle. The &eTungstensteel Crush Head&r has hardness 7."
		""
		"&aBuild:&r"
		"- Craft a &eTungstensteel Crusher Chassis&r."
		"- Craft a &eTungstensteel Furnace Chassis&r."
		"- Install a &eTungstensteel Crush Head&r in the Crusher."
		""
		"&7&oNote: Each chassis has its own recipe. You do not need the old machine to craft a new chassis.&r"
	]
	quest.37A6C9E1284B5D2E.quest_subtitle: "Stage 7 Crusher and Furnace."
	quest.37A6C9E1284B5D2E.title: "Tungstensteel Line"
	quest.37A6C9E1284B5D2F.quest_desc: [
		"A &eNullite Battery Cell&r stores 1,600,000 FE and outputs 2,048 FE/t. The &eNullite Battery Chassis&r holds 8 cells and has a Charge Balancer."
		""
		"&aBuild:&r"
		"1. Assemble one or more &eNullite Battery Cells&r in the &eComponent Assembler&r."
		"2. Place a &eNullite Battery Chassis&r."
		"3. Install the cells in the chassis."
		""
		"&aUse:&r"
		"- Use the bank as a buffer for your machines and fluid lines."
		"- Keep the cells with good rolls."
		""
		"&7&oNote: The bank moves FE at the total rate of its cells. Install enough cells for the rate that you need.&r"
	]
	quest.37A6C9E1284B5D2F.quest_subtitle: "Large Stage 7 energy bank."
	quest.37A6C9E1284B5D2F.title: "Nullite Storage"
	quest.37A6C9E1284B5D30.quest_desc: [
		"The &eTungstensteel Fluid Pump&r moves 500 mB/t, four times as fast as the Osmium pump. The &eTungstensteel Servo&r is the Stage 7 Servo."
		""
		"&aBuild:&r"
		"- Craft a &eTungstensteel Fluid Pump&r."
		"- Craft a &eTungstensteel Servo&r. The recipe needs an Ultimate Electric Circuit and a Lubricant Bucket."
		""
		"&aUse:&r"
		"- Install the pump in a &eMelter&r for faster fluid output."
		"- Install the Servo in machines that need more speed and stability."
	]
	quest.37A6C9E1284B5D30.quest_subtitle: "Stage 7 pump and Servo."
	quest.37A6C9E1284B5D30.title: "High-Stage Fluid Control"
	quest.37A6C9E1284B5D31.quest_desc: ["You completed the RNGTech quest line."]
	quest.37A6C9E1284B5D31.quest_subtitle: "The end of the quest line."
	quest.37A6C9E1284B5D31.title: "Done"
	quest.37A6C9E1284B5D32.quest_desc: [
		"Optional. The &eCopper Furnace Chassis&r heats faster and uses less &bFE&r for each smelt than the Iron chassis."
		"With a &eCopper Heat Core&r, it reaches 1,000 °C. This is enough for Tin, Zinc, and Gold."
		""
		"&aBuild:&r"
		"1. Craft a &eCopper Furnace Chassis&r."
		"2. Install a &eCopper Heat Core&r."
		"3. Install a Battery Cell."
		"4. Supply a steady flow of &bFE&r."
		""
		"&7&oNote: Steel Blend needs 1,100 °C. A Copper Furnace needs a Max Temperature affix to reach it.&r"
	]
	quest.37A6C9E1284B5D32.quest_subtitle: "A hotter core and faster heat."
	quest.37A6C9E1284B5D32.title: "Copper Furnace"
	quest.37A6C9E1284B5D33.quest_desc: [
		"The &eBronze Furnace Chassis&r has a speed bonus on Bronze Blend and Steel Blend."
		"With a &eBronze Heat Core&r, it reaches 1,200 °C. This is enough for Steel Blend."
		"It is also the first Furnace for Nickel, Lead, and Silver. They need 1,100 °C and 0.95 Temperature Stability."
		""
		"&aBuild:&r"
		"1. Craft a &eBronze Furnace Chassis&r. The recipe needs a &eCalibrated Thermal Component&r with 45 or more stability."
		"2. Install a &eBronze Heat Core&r."
	]
	quest.37A6C9E1284B5D33.quest_subtitle: "Hotter core, faster blend smelts."
	quest.37A6C9E1284B5D33.title: "Bronze Furnace"
	quest.37A6C9E1284B5D34.quest_desc: [
		"Build one electric Furnace to continue. The Iron path or the Copper path completes this quest."
		""
		"- &eIron&r is the plain baseline."
		"- &eCopper&r heats faster and reaches 1,000 °C."
		""
		"&7&oNote: You can build the other Furnace later. This quest needs only one.&r"
	]
	quest.37A6C9E1284B5D34.quest_subtitle: "Build one electric Furnace to continue."
	quest.37A6C9E1284B5D34.title: "Smelting Path Selected"
	quest.37A6C9E1284B5D35.quest_desc: [
		"Optional path. The &eIron Battery Chassis&r is a reliable one-cell rack with strong per-cell modifier focus."
		""
		"&aBuild:&r"
		"- Place an &eIron Battery Chassis&r."
		"- Install an &eIron Battery Cell&r."
		""
		"&aUse:&r"
		"- Pick this path for predictable storage and no burst risk."
		"- Keep a good rolled cell; it can move into later machines."
	]
	quest.37A6C9E1284B5D35.quest_subtitle: "Stable storage, low drama."
	quest.37A6C9E1284B5D35.title: "Iron Rack"
	quest.37A6C9E1284B5D36.quest_desc: [
		"Optional path. The &eGold Battery Chassis&r is a burst bank. It can push high output for short windows, but its stability is poor."
		""
		"&aBuild:&r"
		"- Place a &eGold Battery Chassis&r."
		"- Feed it with cells that can survive the output demand."
		""
		"&aUse:&r"
		"- Pick this path for startup spikes or hungry machines."
		"- Do not treat burst output as free storage."
	]
	quest.37A6C9E1284B5D36.quest_subtitle: "High burst with overload risk."
	quest.37A6C9E1284B5D36.title: "Gold Flash Bus"
	quest.37A6C9E1284B5D37.quest_desc: [
		"Build one Battery Chassis to continue. Either path completes this quest."
		""
		"Battery Cells and Battery Chassis do different jobs:"
		"- &eBattery Cells&r are Gear. They store &bFE&r inside one machine."
		"- A &eBattery Chassis&r is a storage block. It holds cells and makes them into one energy bank."
		""
		"The cells set the speed of the bank. The bank moves the combined input and output of the cells that hold &bFE&r."
		"- &eIron Battery Chassis&r: 1 cell slot and no leakage."
		"- &eCopper Battery Chassis&r: 2 cell slots and a better transfer rating, with light leakage."
		""
		"&7&oNote: A chassis with 1 full cell and several empty cells gives out only the FE/t of that full cell.&r"
	]
	quest.37A6C9E1284B5D37.quest_subtitle: "Build one Battery Chassis to continue."
	quest.37A6C9E1284B5D37.title: "Storage Path Selected"
	quest.37A6C9E1284B5D38.quest_desc: [
		"You collect the materials for your factory yourself. For this work, RNGTech gives you Modular Field Tools."
		""
		"- A Tool Head sets the tool type and material: Pick, Hammer, Shovel, Digger, Axe, or Treefeller."
		"- A Tool Rod sets durability, speed changes, &bFE&r transfer, Control, and Battery Support."
		"- An optional Battery Cell pays the &bFE&r for tool features. Without &bFE&r, the tool uses only durability."
		""
		"Each head and rod rolls its own rarity and affixes. The assembled tool has no affixes of its own."
		""
		"A tool at 0 durability stops working, but it stays in your inventory. Repair it with the material of its head."
		""
		"&7&oNote: Read the head and rod tooltips before you replace a part.&r"
	]
	quest.37A6C9E1284B5D38.quest_subtitle: "Heads, rods, and Battery Cells."
	quest.37A6C9E1284B5D38.title: "Read: Modular Tools"
	quest.37A6C9E1284B5D39.quest_desc: [
		"The &eTool Bench&r builds modular tools, changes their parts, repairs them, and refines their parts."
		""
		"&aBuild:&r"
		"- Craft a &eTool Bench&r."
		"- Place the &eTool Bench&r."
		""
		"&aUse:&r"
		"1. Leave the Tool slot empty."
		"2. Insert a Tool Head and a Tool Rod in the Build tab."
		"3. Click Apply to build the tool."
		""
		"Put a finished tool in the Tool slot to swap its parts, repair it, or disassemble it. Old parts come back with their rolls."
		""
		"Hammer, Digger, and Treefeller heads need a &eTiny Anvil&r in the Gear tab."
		""
		"&7&oNote: Hover over an empty slot to see what it takes.&r"
	]
	quest.37A6C9E1284B5D39.quest_subtitle: "Build tools and change their parts."
	quest.37A6C9E1284B5D39.title: "Tool Bench"
	quest.37A6C9E1284B5D3A.quest_desc: [
		"Your first tool is a pick. It needs a head and a rod."
		""
		"&aBuild:&r"
		"- Craft a &eFlint Pick Head&r."
		"- Craft a &eWooden Tool Rod&r."
		""
		"&7&oNote: New parts are unidentified. The Unidentified Items quest shows how to identify them.&r"
	]
	quest.37A6C9E1284B5D3A.quest_subtitle: "The parts for your first tool."
	quest.37A6C9E1284B5D3A.title: "Tool Components"
	quest.37A6C9E1284B5D3B.quest_desc: [
		"With the &eTiny Anvil&r in the Gear tab, the &eTool Bench&r makes advanced tools. Flint heads for advanced tools are cheap and show how area tools work."
		""
		"&aBuild:&r"
		"- Craft a &eFlint Hammer Head&r, a &eFlint Digger Head&r, and a &eFlint Treefeller Head&r."
		"- Craft a &eModular Hammer&r, a &eModular Digger&r, and a &eModular Treefeller&r in the &eTool Bench&r."
		""
		"&aUse:&r"
		"- A Hammer breaks a 3x3 area of pickaxe blocks. It skips blocks that are too hard for its head."
		"- A Digger breaks a 3x3 area of shovel blocks, such as dirt, gravel, and sand."
		"- A Treefeller breaks connected logs up to its Tree Fell Limit."
		"- Durability and &bFE&r costs apply only to the blocks that break."
		"- When you swap a head later, the rod keeps its rolls."
		""
		"&7&oNote: Before affixes, a Flint Treefeller Head on a Wooden Tool Rod fells up to 16 logs.&r"
	]
	quest.37A6C9E1284B5D3B.quest_subtitle: "The Tiny Anvil unlocks advanced heads."
	quest.37A6C9E1284B5D3B.title: "Starter Advanced Tools"
	quest.37A6C9E1284B5D3C.quest_desc: [
		"This quest is optional. Flint Shovel and Axe heads complete the starter tool set without metal."
		""
		"&aBuild:&r"
		"- Craft a &eFlint Shovel Head&r and a &eFlint Axe Head&r."
		"- Craft a &eModular Shovel&r and a &eModular Axe&r in the &eTool Bench&r."
		""
		"&aUse:&r"
		"- A Shovel breaks one shovel block, such as dirt, gravel, or sand."
		"- An Axe breaks one axe block, such as a log."
		"- To change a tool type, put a new head on an existing rod in the &eTool Bench&r."
		"- Repair Flint heads with flint."
	]
	quest.37A6C9E1284B5D3C.quest_subtitle: "Optional flint tools for dirt and wood."
	quest.37A6C9E1284B5D3C.title: "Starter Utility Tools"
	quest.37A6C9E1284B5D3E.quest_desc: [
		"Optional. The &eBio Generator&r turns crops and biomass into biogas, then burns the gas for &bFE&r."
		""
		"&aBuild:&r"
		"1. Place a &eBio Generator&r."
		"2. Optional: install a &eBio Chamber&r and a Stage 0-3 Battery Cell in the Gear tab."
		""
		"&aUse:&r"
		"- Insert potatoes, carrots, bread, saplings, seeds, or prepared biomass."
		"- The generator pushes &bFE&r into adjacent machines and cables on every side."
		"- The engine starts when the gas holder has 400 &bFE&r of gas. The first &bFE&r comes after a few seconds."
		"- Set the retention time with the dial on the Process tab."
		"- A short retention time gives more &bFE/t&r. A long retention time gives more &bFE&r from each item."
		""
		"&7&oNote: A potato gives 120 FE. Composted Biomass gives 1,600 FE, and Rich Biomass gives 3,200 FE.&r"
	]
	quest.37A6C9E1284B5D3E.quest_subtitle: "Farm output can become FE."
	quest.37A6C9E1284B5D3E.title: "Organic Generator"
	quest.37A6C9E1284B5D3F.quest_desc: [
		"Optional. The &eWooden Composter&r turns plant scraps into &eComposted Biomass&r. It needs no power."
		""
		"&aBuild:&r"
		"1. Place a &eWooden Composter&r."
		"2. Insert seeds, saplings, leaves, or crop scraps."
		"3. Optional: insert water. Wet compost takes 60 s for each item instead of 120 s."
		""
		"&aUse:&r"
		"- 8 compost units make 1 &eComposted Biomass&r. &eCompost Feedstock&r counts as 2 units."
		"- At least 200 compost units in the input slots add 10% speed."
		"- At least 5 different inputs add another 10% speed."
		"- Extract &eComposted Biomass&r from the bottom."
		""
		"&7&oNote: Crush seeds into Compost Feedstock first. Then 8 seeds make 2 Composted Biomass instead of 1.&r"
	]
	quest.37A6C9E1284B5D3F.quest_subtitle: "Bulk plants become denser fuel."
	quest.37A6C9E1284B5D3F.title: "Wooden Composter"
	quest.37A6C9E1284B5D40.quest_desc: [
		"Optional. &eRich Biomass&r is the strongest early Bio Generator fuel. It gives 3,200 &bFE&r."
		""
		"&aBuild:&r"
		"- Craft &eComposted Biomass&r with Bone Meal, Gunpowder, or &eOrganic Reagent&r."
		""
		"&aUse:&r"
		"- Burn it in the &eBio Generator&r."
		""
		"&7&oNote: Rich Biomass is not furnace fuel. It does not burn in a Solid Fuel Burner.&r"
	]
	quest.37A6C9E1284B5D40.quest_subtitle: "Prepared biomass, higher fuel value."
	quest.37A6C9E1284B5D40.title: "Rich Biomass"
	quest.37A6C9E1284B5D41.quest_desc: [
		"Optional read. The &eAlloy Furnace&r is the full-yield alloy path once Bronze Casing and the Bronze Alloy Crucible are reachable."
		""
		"&aUse:&r"
		"- Pick this path when you want full-yield Bronze before the Stage 4 factory settles in."
		"- Upgrade the chassis and crucible together as alloy inputs get stricter."
		"- Keep this as a side lesson rather than a progression gate until every required component has a survival recipe."
	]
	quest.37A6C9E1284B5D41.quest_subtitle: "Full-yield alloys without the dust tax."
	quest.37A6C9E1284B5D41.title: "Read: Alloy Furnace"
	quest.37A6C9E1284B5D42.quest_desc: [
		"The &eCopper Solid Fuel Burner&r accepts Gear up to Stage 2."
		"A &eCopper Heat Core&r gives 40 &bFE/t&r. A &eCopper Fuel Box&r adds the Fuel Governor, which pauses the burner when the cell is full."
	]
	quest.37A6C9E1284B5D43.quest_desc: [
		"Optional. &eCrude Solar Panels&r provide daylight &bFE&r without fuel. They are weak, but they teach sky access, weather loss, and side extraction."
		""
		"&aBuild:&r"
		"- Place a &eCrude Solar Panel&r with open sky."
		""
		"&aUse:&r"
		"- Pull &bFE&r from the panel into nearby storage or machines."
		"- Expect lower or zero production in bad weather, at night, or in unsupported dimensions."
		"- Treat this as supplemental power until array control opens."
	]
	quest.37A6C9E1284B5D43.quest_subtitle: "Fuel-free trickle power."
	quest.37A6C9E1284B5D43.title: "Crude Solar"
	quest.37A6C9E1284B5D45.quest_desc: [
		"Optional. A &eTank Frame&r is the base of every &eFluid Tank&r."
		""
		"&aBuild:&r"
		"1. Craft a &eTank Frame&r from a &eMachine Frame&r, 2 buckets, and 6 &eIron Rods&r."
		"2. Craft an &eIron Fluid Tank&r from the Tank Frame, 4 glass, and 4 iron ingots."
		"3. Place the tank."
		""
		"&aUse:&r"
		"- Insert fluid on any side, or use the container slots on the Process tab."
		"- A tank holds one fluid at a time."
		""
		"Copper ingots make a &eCopper Fluid Tank&r, and bronze ingots make a &eBronze Fluid Tank&r. The Iron tank holds 16,000 mB, Copper 24,000 mB, and Bronze 32,000 mB."
		""
		"&7&oNote: A broken tank loses its fluid. Empty the tank before you move it.&r"
		"&7&oNote: A &ePurge Bucket&r voids up to 1,000 mB from a tank. Craft it from a bucket and iron bars.&r"
	]
	quest.37A6C9E1284B5D45.quest_subtitle: "A tank stores one fluid without power."
	quest.37A6C9E1284B5D45.title: "Fluid Tank"
	quest.37A6C9E1284B5D46.quest_desc: [
		"Optional. The &eBronze Fluid Tank&r is the last plain tank. It holds 32,000 mB and needs no power or Gear."
		""
		"&aBuild:&r"
		"- Craft a &eBronze Fluid Tank&r from a &eTank Frame&r, 4 glass, and 4 bronze ingots."
		""
		"From Stage 4, &eCompressor Tanks&r compress fluid and store much more in one block."
		""
		"&7&oNote: You do not need an old tank to craft the next tank. Your old tanks stay useful.&r"
	]
	quest.37A6C9E1284B5D46.quest_subtitle: "The last plain tank."
	quest.37A6C9E1284B5D46.title: "Bronze Fluid Tank"
	quest.37A6C9E1284B5D47.quest_desc: [
		"Optional. A &eSteel Compressor Tank&r has a loose tank of 48,000 mB and a compressed store of 480,000 mB."
		"Compression needs a Battery Cell, at least one Servo, and &bFE&r."
		""
		"&aBuild:&r"
		"1. Craft the tank from a &ePressure Tank Frame&r, 4 glass, and 4 steel ingots."
		"2. Place the tank."
		"3. Install a Battery Cell of Stage 4 or lower, for example a &eLead Battery Cell&r."
		"4. Install at least one &eSteel Servo&r."
		"5. Supply &bFE&r on any side."
		""
		"&aUse:&r"
		"- Insert fluid. The fluid goes into the loose tank first."
		"- With power, the tank moves loose fluid into the compressed store."
		"- More Servos compress faster: 1.75x with 2, 2.5x with 3, and 3.5x with 4."
		""
		"The Servos on top of the tank move while it compresses. The gauge shows how full the compressed store is."
		""
		"&7&oNote: Idle storage costs no FE. To drain compressed fluid costs a quarter of the compression FE. Without power, compressed fluid stays in the tank.&r"
	]
	quest.37A6C9E1284B5D47.quest_subtitle: "Powered fluid storage starts here."
	quest.37A6C9E1284B5D47.title: "Steel Compressor Tank"
	quest.37A6C9E1284B5D49.quest_desc: [
		"The &eCrude Metal Press&r presses plates and Electric Circuits. It never ruins an input. When the conditions are wrong, it waits."
		""
		"&aBuild:&r"
		"1. Place a &eCrude Metal Press&r."
		"2. Install a &eBronze Heat Core&r in the Gear tab."
		"3. Install a &eCircuit Mold&r and select it."
		"4. Install a Battery Cell. Without a cell, the press works more slowly."
		""
		"&7&oNote: With a Bronze Heat Core, the press reaches 1,400 °C. Basic Electric Circuits need 1,300 °C.&r"
		"&7&oNote: Each Bronze Heat Core needs 2 Blaze Rods.&r"
	]
	quest.37A6C9E1284B5D49.quest_subtitle: "The first press for plates and circuits."
	quest.37A6C9E1284B5D49.title: "Crude Metal Press"
	quest.37A6C9E1284B5D4A.quest_desc: [
		"Optional. Connector modules go in a &eUniversal Connector&r. An Energy Connector moves &bFE&r, a Fluid Connector moves fluids, and an Item Connector moves items."
		""
		"&aBuild:&r"
		"1. Craft a &eConnector Mold&r."
		"2. Install the mold in a &eMetal Press&r."
		"3. Craft a &eBasic Energy Connector&r from an &eIron Coil&r."
		"4. Craft a &eBasic Fluid Connector&r from an &eIron Casing&r."
		"5. Craft a &eBasic Item Connector&r from an &eIron Gear&r."
		""
		"&aUse:&r"
		"1. Right-click a Universal Connector with an empty hand."
		"2. Install each module in its tab."
		"3. Set the channel, mode, and Attach As of each module."
		""
		"&7&oNote: You cannot place a module directly on a Cable. Install it in a Universal Connector.&r"
	]
	quest.37A6C9E1284B5D4A.quest_subtitle: "Modules decide what the Cable moves."
	quest.37A6C9E1284B5D4A.title: "Connector Modules"
	quest.37A6C9E1284B5D4D.quest_desc: [
		"Optional. Crush the crushed material again to get dust."
		""
		"&aBuild:&r"
		"- Crush &eCrushed Iron&r into &eIron Dust&r."
		"- Crush &eCrushed Copper&r into &eCopper Dust&r."
		""
		"&aUse:&r"
		"- Smelt dust instead of crushed material. Crushed material takes 3 times as long to smelt and costs more energy."
		""
		"&7&oNote: The dust pass gives 1 dust for each crushed item. It never gets bonus output.&r"
	]
	quest.37A6C9E1284B5D4D.quest_subtitle: "Dust smelts faster than crushed material."
	quest.37A6C9E1284B5D4D.title: "Keep Crushing It"
	quest.37A6C9E1284B5D4E.quest_desc: [
		"Optional. The &eIron Furnace Chassis&r is the plain electric Furnace. With an &eIron Heat Core&r, it reaches 800 °C."
		""
		"&aBuild:&r"
		"1. Craft an &eIron Furnace Chassis&r."
		"2. Install an &eIron Heat Core&r."
		"3. Install a Battery Cell. Without a cell, the Furnace smelts 25% more slowly."
		"4. Supply &bFE&r on any side."
		""
		"&7&oNote: Affixes can raise the Max Temperature above this value.&r"
	]
	quest.37A6C9E1284B5D4E.quest_subtitle: "The first electric Furnace."
	quest.37A6C9E1284B5D4E.title: "Iron Furnace Chassis"
	quest.39580D0D592ED993.quest_desc: [
		"The &eNullifier Coil&r removes one random rolled affix. It costs 1 to 4 RP and needs no forge upgrade."
		""
		"&7&oNote: You cannot select the affix that it removes. Fixed traits and base stats stay.&r"
	]
	quest.3A817746747CF255.quest_desc: ["Install a Crush Head in the Head slot of the &eMiner's Companion&r to enable Block Chew. Any Crush Head fits."]
	quest.3A8FCB54EB8B1E89.quest_desc: [
		"Optional. A &eCrude Solar Panel&r makes 4 &bFE/t&r on a clear day, 1 &bFE/t&r in rain, and nothing at night."
		""
		"&aUse:&r"
		"- Place the panel where the block above it can see the sky."
		"- Place a Cable under the panel pad or next to the panel. The panel pushes &bFE&r into it."
		""
		"&7&oNote: Any block above a panel blocks it. This includes another panel.&r"
	]
	quest.3A8FCB54EB8B1E89.title: "Harvest the Sun"
	quest.3AA3B714F8C4EE77.quest_desc: ["With the &eGreater Affix Upgrader&r, the &eResonance Crystal&r keeps the roll quality of the upgraded affix in its new tier."]
	quest.3B2B69FA1DBA2CCE.quest_desc: ["Insert the &eKinetic Modifier Lens&r in the focus slot of the Affix Forge. It makes speed and motion affixes 3 times as likely."]
	quest.3C127DCECF78A9B0.quest_desc: [
		"The Dehumidifier also makes &bCarbon Exhaust&r from &eCoal Dust&r or Gasification Residue and stored &bWater&r."
		""
		"&aUse:&r"
		"1. Insert &eCoal Dust&r in the conversion slot."
		"2. Wait 5 minutes. Each batch uses 1 item and 1,000 mB of &bWater&r, and makes 1,000 mB of &bCarbon Exhaust&r."
		"3. Select Carbon Exhaust as the output."
		"4. Insert an empty bucket in the container slot."
	]
	quest.3C127DCECF78A9B0.quest_subtitle: "Coal Dust becomes Carbon Exhaust."
	quest.3C127DCECF78A9B0.title: "Carbon"
	quest.3E0E5C8A95264360.quest_desc: [
		"Upgrade your tool heads and rods as you progress."
		"Keep the parts with good rolls."
		"Recycle the parts that you do not need."
	]
	quest.40D4269464D0C039.quest_desc: [
		"RNGTech works with optional mods that show more information in the game."
		""
		"- GuideME: shows the RNGTech wiki as a guide. Hover over an RNGTech item and hold the guide key to open its page."
		"- JEI: shows the recipes of every RNGTech machine, the Gear that fits each machine, and ore pages with depth and hardness."
		"- Jade: shows machine information when you look at a placed RNGTech block."
		""
		"&7&oNote: A feature is available only when the pack includes its mod.&r"
	]
	quest.40D4269464D0C039.quest_subtitle: "Find information in the game."
	quest.40D4269464D0C039.title: "Read: Guides and JEI"
	quest.4256134BC1B890B1.quest_desc: [
		"Install the &eMiner's Companion Magnet&r in the Magnet slot. Then turn on the Mag toggle on the Process tab."
		""
		"The magnet costs 1 &bFE/t&r while it is on, plus 2 &bFE&r for each item stack that it pulls."
	]
	quest.42BFA6CFEA87EC68.quest_desc: [
		"Go to the Nether. You need Nether Quartz and Blaze Rods to continue."
		""
		"- Insulators, the &eCircuit Mold&r, and circuit blanks use Nether Quartz."
		"- Each &eBronze Heat Core&r uses 2 Blaze Rods."
		""
		"&7&oNote: You can make the portal obsidian in place with a lava bucket and a water bucket.&r"
	]
	quest.42BFA6CFEA87EC68.quest_subtitle: "Nether Quartz unlocks the Circuit Mold."
	quest.42BFA6CFEA87EC68.title: "Nether Quartz"
	quest.434B80FD3A2F478A.quest_desc: [
		"Calibrate a &eBasic Electric Circuit&r with the &eLogic Calibration Pattern&r and Nether Quartz."
		"The &eAdvanced Circuit Blank&r needs 55 or more stability."
	]
	quest.43C251ACD9DDDCDF.quest_desc: [
		"The &eAdvanced Item Filter&r is a reusable filter for an Item row. Craft it from a &eBasic Item Connector&r, a &eBasic Electric Circuit&r, redstone, and a glass pane."
		""
		"&aUse:&r"
		"1. Right-click the filter to configure it."
		"2. Set it to allow or deny."
		"3. Select what it matches: items, tags, mod, stage, Stability, identified state, or rarity."
		"4. Insert the filter in a filter slot of an Item row."
		""
		"Deny filters apply first, then allow filters. A row with only deny filters passes all items that it does not deny."
		""
		"&7&oNote: The &eMiner's Companion&r accepts the same filter.&r"
	]
	quest.43C251ACD9DDDCDF.quest_subtitle: "One filter, many rules."
	quest.43C251ACD9DDDCDF.title: "Advanced Item Filter"
	quest.44B6B0AADE341E23.quest_desc: [
		"The &eConfigurator&r copies the settings of one &eUniversal Connector&r and pastes them onto other connectors."
		""
		"&aUse:&r"
		"1. Configure one connector."
		"2. Right-click it with the Configurator."
		"3. Select &eCopy All&r, or copy only the Energy, Fluid, or Item settings."
		"4. Right-click the next connector and select &ePaste&r."
		""
		"Paste sets the channels, modes, Distribution, Attach As, and filters. It does not change the installed modules."
		""
		"To edit the preset, hold the Configurator and press the Open Configurator Preset key. In the preset screen:"
		"- Set &eMod On&r to also install the matching modules from your inventory."
		"- Set &eGear On&r to fill the empty Gear slots of a machine from your inventory."
		"- Use &eFlip&r to change all inputs to outputs and all outputs to inputs."
		""
		"&7&oNote: The Open Configurator Preset key has no default binding. Set it under Controls.&r"
	]
	quest.4653761EC24BB69A.quest_desc: [
		"Optional. The &eWooden Dehumidifier&r collects &bWater&r from the air. It needs no power."
		""
		"&aBuild:&r"
		"1. Build a hollow 3x3x3 cube from 25 &eWooden Dehumidifier Frames&r."
		"2. Leave the center of the cube empty."
		"3. Leave out the middle block of one side."
		"4. Place the &eWooden Dehumidifier&r controller in that gap, with its front to the outside."
		""
		"F = Frame, A = Air, C = Controller"
		""
		"Layer 1"
		"FFF"
		"FFF"
		"FFF"
		""
		"Layer 2"
		"FCF"
		"FAF"
		"FFF"
		""
		"Layer 3"
		"FFF"
		"FFF"
		"FFF"
		""
		"&aUse:&r"
		"- The structure makes &bWater&r only when it can see the sky."
		"- Wet biomes and rain make more &bWater&r, up to 1,500 mB each minute."
		"- Fill buckets in the container slot, or extract the &bWater&r with pipes."
		""
		"&7&oNote: Other shapes do not form. Frames outside the cube do nothing.&r"
	]
	quest.4653761EC24BB69A.quest_subtitle: "A wooden multiblock that collects water."
	quest.4653761EC24BB69A.title: "Water Source"
	quest.46A1F2C0DE100001.quest_desc: [
		"Most Stage 0-3 machines use a &eMachine Frame&r in their recipe."
		""
		"&aBuild:&r"
		"- Craft a &eMachine Frame&r."
	]
	quest.46A1F2C0DE100001.title: "Machine Frame"
	quest.46A1F2C0DE100010.quest_desc: [
		"&aBuild:&r"
		"1. Craft 4 &eAdvanced Circuit Blanks&r. The recipe needs a &eCalibrated Logic Component&r with 55 or more stability."
		"2. Press each blank into an &eAdvanced Electric Circuit&r with the &eCircuit Mold&r."
		""
		"The blank recipe also uses a Basic Electric Circuit, Gold Coils, a Steel Plate, and Insulators."
		""
		"&7&oNote: The press needs 1,300 °C and 1.05 Temperature Stability. A Steel Servo helps the press reach it.&r"
	]
	quest.46A1F2C0DE100010.title: "Advanced Electric Circuit"
	quest.46A1F2C0DE100020.quest_desc: [
		"Most Stage 4 Steel and Lead machines use a &eReinforced Machine Frame&r."
		""
		"&aBuild:&r"
		"- Craft a &eReinforced Machine Frame&r from a Machine Frame, Steel Plates, Steel Casings, and Basic Electric Circuits."
		""
		"&7&oNote: Press Steel Casings with the Casing Mold.&r"
	]
	quest.46A1F2C0DE100020.title: "Reinforced Machine Frame"
	quest.46A1F2C0DE100030.quest_desc: [
		"Stage 5 and Stage 6 machine bodies use the &eAdvanced Machine Frame&r."
		""
		"&aBuild:&r"
		"- Craft an &eAdvanced Machine Frame&r."
		""
		"&7&oNote: The recipe needs a Calibrated Structural Component of Stage 2 or higher with 60 or more stability.&r"
	]
	quest.46A1F2C0DE100030.title: "Advanced Machine Frame"
	quest.46A1F2C0DE100040.quest_desc: [
		"Stage 6 and Stage 7 recipes use the &eElite Electric Circuit&r. Examples are the Titanium Furnace Chassis, the Titanium Servo, and the Exotic Machine Frame."
		""
		"&aBuild:&r"
		"1. Craft an &eElite Circuit Blank&r."
		"2. Press the blank in a &eMetal Press&r with a &eCircuit Mold&r at 1,600 °C."
		""
		"&7&oNote: The blank needs a Titanium Resonance Coil, a Titanium Control Board, and a Calibrated Logic Component with 80 or more stability.&r"
	]
	quest.46A1F2C0DE100040.title: "Elite Electric Circuit"
	quest.46A1F2C0DE100050.quest_desc: [
		"Stage 7 and Stage 8 machine bodies use the &eExotic Machine Frame&r."
		""
		"&aBuild:&r"
		"1. Assemble a &eLubricated Frame Coupling&r from a Tungstensteel Casing and 1,000 mB of &bLubricant&r in the &eComponent Assembler&r."
		"2. Craft the &eExotic Machine Frame&r."
		""
		"&7&oNote: The recipe also needs a Calibrated Structural Component of Stage 3 or higher with 80 or more stability.&r"
	]
	quest.46A1F2C0DE100050.title: "Exotic Machine Frame"
	quest.46A1F2C0DE100060.quest_desc: [
		"Stage 7 and Stage 8 recipes use the &eUltimate Electric Circuit&r. Examples are the Exotic chassis, late Servos, and Nullite and Exotic collapse Gear."
		""
		"&aBuild:&r"
		"1. Craft an &eUltimate Circuit Blank&r."
		"2. Press the blank in a &eMetal Press&r with a &eCircuit Mold&r at 2,000 °C."
		""
		"&7&oNote: The blank needs Naquadah Coils, a Nullite Resonance Coil, Elite Electric Circuits, and a Calibrated Diamond Crystal with 85 or more stability.&r"
	]
	quest.46A1F2C0DE100060.title: "Ultimate Electric Circuit"
	quest.46A1F2C0DE100070.quest_desc: [
		"The &ePhase Cradle&r is the end of the Phase Array, the Stage 8 refinement bench. You choose the operation: raise, remove, add, swap, or reforge an affix, and a pulse decides whether it holds."
		""
		"&aBuild:&r"
		"- Craft a &ePhase Cradle&r, three &ePhase Coils&r, and a &ePhase Emitter&r, and place them in a straight row."
		""
		"&aUse:&r"
		"- Supply &bFE&r to any side."
		"- Open the Cradle, seat a Glyph of each tier you have in its seat, and put the item in the Cradle."
		"- Pick an operation, read its odds, then charge and fire."
		""
		"&7&oNote: A pulse costs FE that grows with the item's affix tiers, and every pulse adds Strain.&r"
	]
	quest.46A1F2C0DE100070.quest_subtitle: "Choose exactly how to refine an item."
	quest.46A1F2C0DE100070.title: "Phase Cradle"
	quest.492E007D03CA2C13.quest_desc: [
		"Optional. A Recovery Filter in the Filter slot gives each chewed item a small chance to return an item from a recovery recipe."
		""
		"RNGTech has no recovery recipes of its own. Modpacks and datapacks add them. JEI lists the loaded recipes."
	]
	quest.49D6781084057122.quest_desc: [
		"Craft the Seal from these items:"
		"- 4 &eTungstensteel Plates&r"
		"- 2 &eNullite Plates&r"
		"- 1 &eElite Electric Circuit&r"
		"- 1 &eLubricated Seal Core&r"
		"- 1 &eCalibrated Diamond Crystal&r of Stage 6 with 85% or more stability"
		""
		"Use it on a machine that already used Seal I."
	]
	quest.49D6781084057122.quest_subtitle: "Seal II gives 2 more points."
	quest.49D6781084057122.title: "Ascendancy Seal II"
	quest.4AD05360B50DFAE6.quest_desc: ["Insert the &eSpeed Modifier Lens&r in the focus slot of the Affix Forge. It makes Speed affixes 3 times as likely."]
	quest.4B16F7B54131FB30.quest_desc: [
		"With the &eGreater Affix Upgrader&r, the &eDestabilization Crystal&r rerolls the other affixes of the item at their current tiers."
		""
		"&7&oNote: The Greater Affix Upgrader needs the Affix Resonance Matrix.&r"
	]
	quest.4B285A35E920898A.quest_desc: ["With the &eGreater Affix Upgrader&r, the &eTransmutation Crystal&r changes the upgraded affix to a different affix in the same prefix or suffix slot."]
	quest.4CC5AA5185C3D06B.quest_desc: [
		"The &eComponent Assembler&r combines items with a fluid to make components."
		""
		"&aBuild:&r"
		"- Craft a &eComponent Assembler&r."
		""
		"&aUse:&r"
		"- Use &bElectrolyte Solution&r for Primed Cell Cores, Battery Cells, and Anodes."
		"- Use &bLubricant&r for Titanium and higher Servos and the Lubricated Frame Coupling."
		"- Use &bEnder Slurry&r for Void Catalyst."
		""
		"&7&oNote: The Melter makes Electrolyte Solution from Sugar, Redstone, and Water.&r"
	]
	quest.4D576FB3BBF8C6D4.quest_desc: [
		"Craft a &eLubricated Seal Core&r in the &eComponent Assembler&r from these items:"
		"- 1 &ePrimed Seal Core&r"
		"- 1 &eTungstensteel Casing&r"
		"- 1 &eNullite Coil&r"
		"- 1 &eElite Electric Circuit&r"
		"- 1,000 mB of &bLubricant&r"
	]
	quest.4D576FB3BBF8C6D4.quest_subtitle: "The core for Seals II and III."
	quest.4D576FB3BBF8C6D4.title: "Lubricated Seal Core"
	quest.4DE87D2F3D084228.quest_desc: [
		"Optional. Two Metal Press ascendancy notables let the press anneal what it makes with &bHydrogen&r."
		""
		"- Bright Anneal (Die Keeper, after Purge Line): Basic Electric Circuits come out Annealed."
		"- Hydrogen Quench (Drop Forge, after Quench Line): plates come out Annealed."
		""
		"&aUse:&r"
		"1. Allocate Bright Anneal or Hydrogen Quench on a &eMetal Press&r."
		"2. Supply &bHydrogen&r to the atmosphere tank of the press. The tank must hold no Nitrogen."
		"3. Press circuits or plates. Each Annealed item uses 250 mB of Hydrogen."
		""
		"An Annealed Basic Electric Circuit calibrates with better stability. The Resonance Calibrator rolls the stability two times and keeps the higher roll."
		"Gear that you craft only from Annealed plates rolls its Refinement Potential two times and keeps the higher roll."
		""
		"&7&oNote: Annealed items do not stack with plain items. Only the plates in the crafting grid of the item count.&r"
	]
	quest.4DE87D2F3D084228.quest_subtitle: "Anneal plates and circuits with Hydrogen."
	quest.4DE87D2F3D084228.title: "Hydrogen Annealing"
	quest.4F5AA1D34A0C1A4C.quest_desc: [
		"Electric Circuits unlock the electric machines."
		""
		"&aBuild:&r"
		"1. Craft &eInsulators&r from glass, Nether Quartz, clay, and smooth stone."
		"2. Craft 4 &eBasic Circuit Blanks&r from Insulators, a Bronze Plate, a Copper Coil, redstone, and Nether Quartz."
		"3. Press each blank into a &eBasic Electric Circuit&r with the &eCircuit Mold&r."
		""
		"&7&oNote: The Basic Electric Circuit needs 1,300 °C and 0.95 Temperature Stability.&r"
	]
	quest.4F5AA1D34A0C1A4C.quest_subtitle: "Press your first Basic Electric Circuit."
	quest.4F5AA1D34A0C1A4C.title: "Pressed Circuits"
	quest.4F6A5736BFB8557E.quest_desc: [
		"The &eVolatile Catalyst&r corrupts a finished Gear part, Battery Cell, or placed machine. It costs no RP. It is the only catalyst that changes a &6Unique&r."
		""
		"It rolls one outcome, each at 20%: Untouched, Blessed, Reforged, Warped, or Blighted. After any outcome, the item is Corrupted and you cannot refine it again."
		""
		"&aBuild:&r"
		"1. Calibrate a Stage 5 &eCalibrated Kinetic Component&r with 20% to 35% stability."
		"2. Collect 2 &eMalformed Ingots&r of a Stage 5 or higher metal from failed Furnace, Metal Press, or Alloy Furnace cycles."
		"3. Collect 2 &eJam Debris&r from Crusher jams on recipes of hardness 5 or higher."
		"4. Craft the catalyst from these items and 4 &eSparksteel Plates&r."
		""
		"&7&oNote: For low stability, use a weaker Control Board, no Stabilizer Matrix, or no Battery Cell in the Resonance Calibrator.&r"
		""
		"&aUse:&r"
		"- Insert it in an &eAffix Forge&r that has an &eAffix Resonance Matrix&r."
		"- Or insert it in the Refinement tab of a placed machine."
		"- Insert a &eStabilization Crystal&r in the focus slot of the forge to remove the Blighted outcome."
		""
		"&7&oNote: You cannot corrupt a machine item. Place the machine, then use its Refinement tab.&r"
	]
	quest.4F6A5736BFB8557E.quest_subtitle: "Corruption is a one-way gamble."
	quest.4F6A5736BFB8557E.title: "Volatile Catalyst"
	quest.51085B8552CE2F6C.quest_desc: [
		"Craft your first tool from its parts."
		""
		"&aBuild:&r"
		"1. Open the Build tab of the &eTool Bench&r."
		"2. Leave the Tool slot empty."
		"3. Insert the &eFlint Pick Head&r and the &eWooden Tool Rod&r."
		"4. Click Apply."
		""
		"&aUse:&r"
		"- A Flint head reaches ore hardness 1. It mines Iron Ore and Copper Ore."
		"- Compare the tooltips of the head, the rod, and the tool."
		"- To repair the tool, put flint in the repair slot of the &eTool Bench&r and click Apply."
		"- Each flint restores up to a quarter of the durability. A vanilla anvil also accepts flint."
		"- Keep parts with good rolls for later swaps."
		""
		"&7&oNote: Two tools in a crafting grid do not combine. Use the Tool Bench to repair.&r"
	]
	quest.51085B8552CE2F6C.quest_subtitle: "Your first modular tool."
	quest.510CAD7DC389C5A5.quest_desc: [
		"Install the &eMining Lamp&r in the Lamp slot of the &eMiner's Companion&r. Then turn on the Lamp toggle on the Process tab."
		""
		"The lamp gives light level 14 and costs 1 &bFE/t&r. Only you see the light, and it does not stop mob spawns."
	]
	quest.514C23AEB9AC2C85.quest_desc: [
		"Copper heads reach ore hardness 2. They mine faster than Iron heads, but they have less durability."
		""
		"&aBuild:&r"
		"- Craft &eCopper Plates&r with the &eForming Hammer&r."
		"- Craft a &eCopper Gear&r and &eCopper Rods&r."
		"- Craft the Copper Hammer, Digger, and Treefeller heads."
	]
	quest.514C23AEB9AC2C85.quest_subtitle: "Optional copper heads for advanced tools."
	quest.514C23AEB9AC2C85.title: "Copper Advanced Tools"
	quest.51F687AFE8743543.quest_desc: ["Insert the &eControl Modifier Lens&r in the focus slot of the Affix Forge. It makes Control affixes 3 times as likely."]
	quest.53AD85A55402A1A2.quest_desc: [
		"Craft a &ePrimed Seal Core&r in the &eComponent Assembler&r from these items:"
		"- 1 &eSparksteel Coil&r"
		"- 1 &eAluminum Casing&r"
		"- 4 redstone"
		"- 1 &eStabilization Catalyst&r"
		"- 1,000 mB of &bElectrolyte Solution&r"
	]
	quest.53AD85A55402A1A2.quest_subtitle: "Every Seal needs a Seal Core."
	quest.53AD85A55402A1A2.title: "Primed Seal Core"
	quest.53AF2FB3A673F2DB.quest_desc: [
		"The &eExotic Machine Frame&r needs a &eCalibrated Structural Component&r of Stage 3 or higher with 80 or more stability."
		""
		"&aBuild:&r"
		"1. Select the Structural pattern in a Resonance Calibrator."
		"2. Calibrate an Iron Plate with a Matrix and a Stabilization Catalyst."
		""
		"&7&oNote: This recipe makes a Stage 3 component with 65 to 95 stability. The Titanium Calibrator gives better stability rolls.&r"
	]
	quest.53AF2FB3A673F2DB.quest_subtitle: "High-stability parts for the Exotic frame."
	quest.53AF2FB3A673F2DB.title: "Precision Calibration"
	quest.53F2D28C45DFDD39.quest_desc: [
		"Optional. The &eCopper Component Recycler&r is the Stage 2 Recycler. It accepts Disassembly Heads and Recovery Filters up to Stage 2."
		""
		"&aBuild:&r"
		"- Craft a &eCopper Component Recycler&r."
		""
		"&aUse:&r"
		"- Recycle bad rolled parts before they fill your storage."
		"- Install a Recovery Filter for extra returns."
	]
	quest.53F2D28C45DFDD39.quest_subtitle: "Recover value from bad parts."
	quest.53F2D28C45DFDD39.title: "Copper Recycler"
	quest.5410F981F9D5914E.quest_desc: [
		"The &eAffix Modifier Socket&r is the second upgrade for the &eAffix Forge&r. It unlocks modifier crystals in the focus slot. A crystal changes how a catalyst works."
		""
		"&7&oNote: You cannot use a lens and a crystal together.&r"
	]
	quest.56BF8BBA48C36C74.quest_desc: [
		"Craft a &eTiny Anvil&r and install it in the Gear tab of the &eTool Bench&r."
		""
		"The &eTiny Anvil&r unlocks Hammer, Digger, and Treefeller heads. The bench never uses it up."
	]
	quest.56BF8BBA48C36C74.quest_subtitle: "Unlock the advanced tools."
	quest.56BF8BBA48C36C74.title: "Hammertime"
	quest.5704E39094767FA2.quest_desc: [
		"The &eChaos Crystal&r rerolls all current affixes of an item. The rarity and the number of prefixes and suffixes stay the same."
		""
		"&7&oNote: Its recipe needs &eCollapse Residue&r from the Vacuum Collapse Generator.&r"
	]
	quest.59C090170DAE7A69.quest_desc: [
		"&aBuild:&r"
		"1. Insert 1 &eIron Dust&r, 1 Coal, and 1 Charcoal into the Alloy Furnace."
		"2. Wait for the &eSteel Blend&r. The recipe is slow: it takes 1,800 ticks."
		"3. Smelt the &eSteel Blend&r in an electric Furnace at 1,100 °C."
		""
		"&7&oNote: A Copper Furnace with a Copper Heat Core reaches only 1,000 °C. Get 100 °C more from a Max Temperature affix, such as White-Hot or Searing.&r"
		"&7&oNote: The direct recipe with an Iron Ingot and Coal needs 1,300 °C. The Bronze Alloy Furnace cannot reach it.&r"
	]
	quest.5AA63386A798DA28.quest_desc: ["The &eNull Crystal&r removes one random rolled affix. It costs 1 to 4 RP."]
	quest.5BBDB9F10C9545BF.quest_desc: [
		"Optional. The &eSteel Alloy Furnace Chassis&r is the Stage 4 Alloy Furnace. It has Output Guard."
		"With a &eSteel Heat Core&r, it reaches 1,100 °C."
		""
		"&aBuild:&r"
		"1. Craft a &eSteel Alloy Furnace Chassis&r. Its recipe uses 2 &eSteel Heat Cores&r."
		"2. Install a &eSteel Heat Core&r and a &eSteel Alloy Crucible&r."
		""
		"&aUse:&r"
		"- Make 3 &eInvar Ingots&r from 2 Iron Ingots and 1 Nickel Ingot at 1,050 °C."
		"- Make Steel Ingots directly from an Iron Ingot, Coal Dust, and Charcoal at 1,100 °C."
		""
		"&7&oNote: Stage 4 recipes need a Stage 4 chassis and a Stage 4 crucible.&r"
	]
	quest.5BBDB9F10C9545BF.quest_subtitle: "Hotter alloys and direct Steel."
	quest.5BBDB9F10C9545BF.title: "Steel Alloy Furnace"
	quest.5C1326D78226482C.quest_desc: [
		"The &eAffix Lens Array&r is the first upgrade for the &eAffix Forge&r. Install it in an upgrade slot. It unlocks modifier lenses in the focus slot."
		""
		"A lens makes affixes of its family 3 times as likely. Other affixes can still roll. Lenses work with the Affix Injector, Affix Upgrader, and Greater Affix Upgrader."
		""
		"&7&oNote: On success, the forge uses up the catalyst and the lens. Upgrades stay installed.&r"
	]
	quest.5C7D614307ED2822.quest_desc: [
		"Craft the Seal from these items:"
		"- 4 &eNaquadah Plates&r"
		"- 1 &eExotic Machine Frame&r"
		"- 1 &eUltimate Electric Circuit&r"
		"- 2 &eLubricated Seal Cores&r"
		"- 1 &eCalibrated Diamond Crystal&r of Stage 6 with 95% or more stability"
		""
		"Use it on a machine that already used Seal II. Seal III completes the 6 ascendancy points of the machine."
	]
	quest.5C7D614307ED2822.quest_subtitle: "The last Seal tier."
	quest.5C7D614307ED2822.title: "Ascendancy Seal III"
	quest.5E1CA6E1D5C00500.quest_desc: [
		"The &eSilica Gel Dehumidifier&r makes &bWater&r from desiccant beads. It needs no power, and it works underground and in the Nether."
		""
		"At full speed, it makes about twice the water of a Wooden Dehumidifier."
		""
		"&aBuild:&r"
		"1. Place the &eSilica Gel Dehumidifier&r."
		"2. Place two &eSilica Gel Column Casings&r directly on top of it."
		""
		"&aUse:&r"
		"- Insert dry &eSilica Gel Beads&r in the lane input slots."
		"- Extract &bWater&r from the sides of the controller or the casings."
		"- Smelt &eSaturated Silica Gel Beads&r in a &eFurnace&r to dry them again."
		""
		"&7&oNote: The casings cover the top face. Insert the dry beads by hand.&r"
	]
	quest.5E1CA6E1D5C00500.quest_subtitle: "Water from beads, anywhere."
	quest.5E1CA6E1D5C00500.title: "Silica Gel Dehumidifier"
	quest.5E554A3E956A8F68.quest_desc: ["Insert the &eStability Modifier Lens&r in the focus slot of the Affix Forge. It makes Stability affixes 3 times as likely."]
	quest.5FCF4CF08C2ECD07.quest_desc: [
		"Calibrate a &eCopper Casing&r with the &eThermal Calibration Pattern&r and Glowstone Dust."
		"The &eBronze Furnace Chassis&r and the &eAlloy Solid Fuel Burner&r need 45 or more stability. Steel machines need 55 or more."
	]
	quest.61F18F2CD460DDD9.quest_desc: [
		"Optional. Stage 3-4 adds more ways to make &bFE&r:"
		"- Burn crops and biomass in the &eBio Generator&r."
		"- Grow algae fuel in the &eAlgae Photobioreactor&r."
		"- Dissolve metal plates in the &eCorrosion Cell&r."
		"- Collect sunlight with &eSolar Panels&r. They need circuits."
		"- Burn solid fuel in a better &eSolid Fuel Burner&r."
	]
	quest.61F18F2CD460DDD9.quest_subtitle: "More ways to make power."
	quest.61F18F2CD460DDD9.title: "Generators"
	quest.62AFD2FEB4686A8A.quest_desc: [
		"With a &eVolatile Catalyst&r, the &eStabilization Crystal&r removes the Blighted outcome. Its chance goes to Untouched."
		""
		"&7&oNote: Its recipe needs a Stage 5 Calibrated Conductive Component with 85% or more stability.&r"
	]
	quest.66BFDC3B5C785D23.quest_desc: [
		"An ascendancy is a small specialization tree for one machine family. Each family has two ascendancies. The Forestry Companion has three."
		""
		"&aUse:&r"
		"1. Open the &eMastery&r tab of a Stage 4 or higher machine."
		"2. Click the crest next to the start node."
		"3. Keep an &eAscendancy Seal I&r in your inventory and press &aAscend&r."
		"4. Select one ascendancy. Its root node is free."
		""
		"- Each Seal gives 2 ascendancy points. Seals I, II, and III give 6 points in total."
		"- Only Seal I checks the stage. The Melter counts as Stage 6, and the Forestry Companion always qualifies."
		"- To refund one ascendancy node costs 5 Mastery Refunds."
		"- &eSwitch&r changes to the other ascendancy. It needs an empty tree and uses one Seal I."
		""
		"&7&oNote: The wiki page of each machine lists its ascendancies.&r"
	]
	quest.66BFDC3B5C785D23.quest_subtitle: "Specialize one machine with Seals."
	quest.66BFDC3B5C785D23.title: "Read: Ascendancies"
	quest.691503A12347F864.quest_desc: [
		"The &eBio Chamber&r is optional Gear for the &eBio Generator&r. It adds rolled &bFE/t&r and fuel duration bonuses."
		"Some chambers roll a bonus for one fuel family, such as potatoes or Composted Biomass."
		""
		"&7&oNote: The Algae Photobioreactor recipe also uses a Bio Chamber.&r"
	]
	quest.69EC812BC41DCD56.quest_desc: [
		"The &eGold Solar Panel&r makes 12 &bFE/t&r on a clear day and 3 &bFE/t&r in rain."
		"Its recipe uses a &eSolar Panel Frame&r, a Gold Coil, and Gold Plates."
	]
	quest.6A3B46D12E418769.quest_desc: [
		"The &eAffix Upgrader&r upgrades one random affix by one tier. It costs 2 to 6 RP."
		"It is strong on a Magic item with two good affixes, because each upgrade improves an affix that you want."
		""
		"&7&oNote: It fails when all affixes are at their top tier. A failure uses nothing.&r"
	]
	quest.6A5586EEBF6EC289.quest_desc: ["A &ePressure Tank Frame&r is the base of every &eCompressor Tank&r. Craft it from a &eReinforced Machine Frame&r, 2 buckets, and 6 &eSteel Rods&r."]
	quest.6AD0EAA001CB1D16.quest_desc: [
		"The &eExotic Battery Chassis&r holds 10 cells. It is the largest and most stable bank, with a Charge Balancer."
		""
		"Each &eExotic Battery Cell&r stores 10,000,000 FE and outputs 4,096 FE/t."
	]
	quest.6B295A9B5D422CB1.quest_desc: [
		"New machines, Gear parts, tool parts, and Battery Cells are unidentified when you craft them. Their rarity, affixes, and RP stay hidden."
		""
		"You cannot refine an unidentified item."
		""
		"&aUse:&r"
		"1. Put 1 unidentified item alone in a crafting grid."
		"2. Take the result out of the grid."
		""
		"You can also place an unidentified machine block. Only the placed block becomes identified."
		""
		"&7&oNote: The crafting preview always shows Unidentified. The rolls appear when you take the item.&r"
	]
	quest.6B295A9B5D422CB1.quest_subtitle: "Reveal the rolls of new items."
	quest.6B295A9B5D422CB1.title: "Unidentified Items"
	quest.6D8585E478E2A8D5.quest_desc: [
		"The &eTungstensteel Compressor Tank&r stores 128,000 mB loose and 4,096,000 mB compressed. It accepts Gear up to Stage 7."
		"Craft it from a &ePressure Tank Frame&r, 4 glass, 2 tungstensteel ingots, and 2 &eTitanium Casings&r."
	]
	quest.6E8257BAA2BB0FDB.quest_desc: [
		"The &eCopper Pick Head&r reaches ore hardness 2. It mines Tin, Zinc, and Gold ore."
		""
		"It mines faster than the &eIron Pick Head&r, but it has less durability. Copper is also an Ore Burst material."
	]
	quest.6FFA7CB5EE660918.quest_desc: ["With the &eAffix Upgrader&r, the &eFrugality Crystal&r gives a 25% chance that the upgrade costs only 1 RP. The crystal is used up."]
	quest.7106E7A1B10F0010.quest_desc: [
		"Optional. The &eAlgae Photobioreactor&r grows &eAlgae Biomass&r from water, carbon gas, and light. It needs no power."
		""
		"&aBuild:&r"
		"1. Craft an &eAlgae Photobioreactor&r. The recipe uses a &eBio Chamber&r and a Basic Electric Circuit."
		"2. Place it where the block above it has light level 12 or more."
		"3. Fill the water tank with &bWater&r."
		"4. Fill the carbon tank with &bCarbon Exhaust&r."
		""
		"&aUse:&r"
		"- The algae culture grows to full density during the first cycle. Without supplies, the culture slowly dies back."
		"- Set the aeration on the Process tab, from 40% to 100%."
		"- More aeration grows algae faster, but each Algae Biomass then uses more gas."
		"- Craft 4 &eAlgae Biomass&r into 1 &eDense Algae Biomass&r."
		"- Burn both items in the &eBio Generator&r."
		""
		"&7&oNote: To start, craft a Carbon Exhaust Bucket from a Water Bucket and Coal Dust.&r"
	]
	quest.7106E7A1B10F0010.quest_subtitle: "Water plus carbon plus light makes fuel."
	quest.7106E7A1B10F0010.title: "Algae Fuel Chain"
	quest.7106E7A1B10F0040.quest_desc: [
		"Optional read. The carbon tank also accepts &bSyngas&r and &bCarbon Monoxide&r. Later machines make these gases."
		""
		"At full density and rated aeration, each Algae Biomass uses 250 mB of &bWater&r and:"
		"- &bCarbon Exhaust&r: 100 mB, 1,200 ticks."
		"- &bSyngas&r: 80 mB, 900 ticks."
		"- &bCarbon Monoxide&r: 500 mB, 600 ticks."
		""
		"Insert &eUrea&r in the Urea slot of the Process tab. The next 4 Algae Biomass then grow at twice the speed with the same water and gas."
		""
		"&7&oNote: The Coal Gasifier makes Syngas. The Steam Methane Reformer makes Carbon Monoxide. The Ammonia Synthesizer makes Urea.&r"
	]
	quest.7106E7A1B10F0040.quest_subtitle: "Better carbon speeds algae later."
	quest.7106E7A1B10F0040.title: "Later Carbon Inputs"
	quest.7106E7A1B10F0050.quest_desc: [
		"Optional. The &eCorrosion Cell&r is a Stage 4 generator. Each cycle, it dissolves one plate in &eElectrolyte&r and makes &bFE&r and &eCorrosion Residue&r."
		""
		"&aBuild:&r"
		"- Craft a &eCorrosion Cell&r from Steel Casings, &eElectrolyte&r, a Bus Bar, a &eReinforced Machine Frame&r, and redstone."
		"- Optional: install a Battery Cell in the Gear tab for more stored &bFE&r."
		""
		"&aUse:&r"
		"- Insert &eIron Plates&r, &eCopper Plates&r, or &eScrap&r from the top."
		"- Insert &eElectrolyte&r from the sides."
		"- Extract &eCorrosion Residue&r from the bottom. The cell pushes &bFE&r out of every face."
		"- Set the load on the Process tab, from 40% to 100%."
		"- A lower load gives less &bFE/t&r, but more &bFE&r from each plate."
		""
		"&7&oNote: At full load, a Copper Plate gives 100 FE/t and an Iron Plate gives 80 FE/t. The cell stops when the residue slot is full.&r"
	]
	quest.7106E7A1B10F0050.quest_subtitle: "Plate plus electrolyte becomes FE and residue."
	quest.7106E7A1B10F0050.title: "Step 1: Corrosion Cell"
	quest.7106E7A1B10F0060.quest_desc: [
		"The &eCavitation Generator&r is a Stage 5 generator. It spins a rotor through &bWater&r to make FE."
		""
		"&aBuild:&r"
		"1. Calibrate a Steel Casing into a &eCavitation Rotor Hub&r with the Kinetic pattern."
		"2. Craft a &eSteel Cavitation Rotor&r from the hub."
		"3. Craft a &eSteel Collapse Nozzle&r and the &eCavitation Generator&r."
		"4. Install the rotor and the nozzle in the Gear tab."
		"5. Optional: install a Heat Core, a Battery Cell, and a Stage 6 or higher Servo."
		""
		"&aUse:&r"
		"- Fill the tank with &bWater&r through pipes or with filled containers."
		"- Set the throttle on the rotor speed gauge. The rated throttle is 70%."
		"- Extract &bFE&r from the sides."
		"- Extract &ePitted Cavitation Rotors&r from the bottom."
		""
		"&7&oNote: The hub is a Stage 5 recipe, so it needs the Titanium Resonance Calibrator.&r"
		"&7&oNote: Each rotor wears about a third as fast at its hidden resonance throttle, between 55% and 90%.&r"
		"&7&oNote: The generator does not stop when its storage is full. It loses the FE that it cannot store.&r"
	]
	quest.7106E7A1B10F0060.quest_subtitle: "Water spins a rotor for FE."
	quest.7106E7A1B10F0060.title: "Step 2: Cavitation Generator"
	quest.7106E7A1B10F0070.quest_desc: [
		"The &eAmmonia Synthesizer&r makes &bAmmonia&r from &bNitrogen&r, &bHydrogen&r, and FE. The &eFuel Cell&r burns the Ammonia for 600 FE/t before rolls."
		""
		"&aBuild:&r"
		"1. Craft two &eAmmonia Catalyst Beds&r. The Synthesizer recipe uses one."
		"2. Craft an &eAmmonia Synthesizer&r and install a bed in its Gear tab."
		"3. Craft three &eFuel Cell Membranes&r. The Fuel Cell recipe uses two."
		"4. Craft a &eFuel Cell&r and install a membrane in its Gear tab."
		"5. Optional: install a Stage 6 or higher Battery Cell in the Fuel Cell."
		""
		"&aUse:&r"
		"- Move &bNitrogen&r and &bHydrogen&r into the Synthesizer."
		"- Supply &bFE&r to the Synthesizer from any side except the bottom."
		"- Move the &bAmmonia&r into the Fuel Cell."
		"- Extract &bFE&r from the top and the sides of the Fuel Cell."
		"- Extract &eCorrosion Residue&r from the bottom of the Fuel Cell."
		""
		"Each Synthesizer cycle turns 500 mB of Nitrogen and 1,500 mB of Hydrogen into 1,000 mB of Ammonia. The Fuel Cell makes 216,000 FE from 1,000 mB of Ammonia."
		""
		"The Fuel Cell can also burn &bHydrogen&r. It makes 60,000 FE from 1,000 mB of Hydrogen, at 200 FE/t, and leaves no residue."
		"The fuel tank holds one fuel at a time. Empty it before you change the fuel. Hydrogen gives more than twice the FE when you make it into Ammonia first."
		""
		"&7&oNote: The Synthesizer is not a generator. After the synthesis cost, the chain makes about 510 FE/t.&r"
		"&7&oNote: With Carbon Exhaust in its tank, the Synthesizer uses some Ammonia to make Urea. The Urea quest shows how.&r"
	]
	quest.7106E7A1B10F0070.quest_subtitle: "Hydrogen and Nitrogen make Ammonia."
	quest.7106E7A1B10F0070.title: "Ammonia Power"
	quest.7106E7A1B10F0090.quest_desc: [
		"The &eVacuum Collapse Generator&r is the Stage 7 primary generator. It collapses one &eVoid Catalyst&r at a time into a large batch of FE."
		""
		"&aBuild:&r"
		"1. Craft two sets of a &eTungstensteel Void Chamber&r, &eCollapse Nozzle&r, and &eDimensional Stabilizer&r."
		"2. Craft the &eVacuum Collapse Generator&r. The recipe uses one set."
		"3. Install the other set in the Gear tab."
		""
		"&aUse:&r"
		"- Insert &eVoid Catalyst&r from the top."
		"- Extract &bFE&r from the sides."
		"- Extract &eCollapse Residue&r from the bottom."
		"- Set the collapse depth from 50% to 150% on the Process tab."
		"- Apply a redstone signal to pause the generator."
		""
		"&7&oNote: The output peaks at the end of each collapse, at 2 times the average. The generator loses the FE that its storage cannot hold.&r"
		"{@pagebreak}"
		"Two machines make the &eVoid Catalyst&r."
		""
		"&aBuild:&r"
		"1. In a &eMelter&r, melt 2 Ender Pearls in 1,000 mB of &bAmmonia&r to make &bEnder Slurry&r."
		"2. Insert a Nullite Ingot in the first slot of a &eComponent Assembler&r."
		"3. Insert a Tungstensteel Plate in the second slot."
		"4. Fill the tank with 1,000 mB of &bEnder Slurry&r."
		""
		"&7&oNote: A Melter at 1,600 °C can melt 1 Ender Pearl and 1 Collapse Residue into 2,000 mB of Ender Slurry.&r"
	]
	quest.7106E7A1B10F0090.quest_subtitle: "Void Catalyst makes large FE batches."
	quest.7106E7A1B10F0090.title: "Vacuum Collapse"
	quest.7106E7A1B10F0100.quest_desc: [
		"RNGTech gases are fluids. Store them in tanks or buckets, and move them like other fluids."
		""
		"&aUse:&r"
		"- Connect gas machines with &eCable&r."
		"- Install a Fluid Connector in the &eUniversal Connector&r on each machine."
		"- Use a purge button or a &ePurge Bucket&r to void up to 1,000 mB of a fluid."
		"- Look in JEI for the gasification, combustion, reforming, and algae recipes."
		""
		"&7&oNote: Most gas machines stop when an output tank is full. Extract all outputs.&r"
	]
	quest.7106E7A1B10F0100.quest_subtitle: "Gases are fluids."
	quest.7106E7A1B10F0100.title: "Read: Gas Chemistry"
	quest.7106E7A1B10F0110.quest_desc: [
		"The &eCoal Gasifier&r turns &eCoal Dust&r and &bWater&r into &bSyngas&r. Each run also makes one &eGasification Residue&r."
		""
		"&aBuild:&r"
		"1. Craft a &eCoal Gasifier&r. The recipe uses one &eAluminum Heat Core&r."
		"2. Install a Stage 5 or higher Heat Core in the Gear tab."
		""
		"&aUse:&r"
		"- Insert &eCoal Dust&r from the top."
		"- Fill the water tank with &bWater&r."
		"- Supply &bFE&r."
		"- Extract &bSyngas&r through pipes."
		"- Extract &eGasification Residue&r from the bottom."
		""
		"Each run uses 1 Coal Dust, 500 mB of Water, and 6,000 FE. It makes 1,000 mB of Syngas."
		""
		"&7&oNote: The Gasifier stops when the Syngas tank or the residue slot is full.&r"
	]
	quest.7106E7A1B10F0110.quest_subtitle: "Coal Dust and water make Syngas."
	quest.7106E7A1B10F0110.title: "Coal Gasifier"
	quest.7106E7A1B10F0120.quest_desc: [
		"The &eSyngas Combustor&r burns &bSyngas&r for 240 FE/t before rolls. Each 1,000 mB of Syngas also makes 500 mB of &bCarbon Exhaust&r."
		""
		"&aBuild:&r"
		"- Craft a &eSyngas Combustor&r."
		""
		"&aUse:&r"
		"- Move &bSyngas&r into the gas tank through pipes."
		"- Extract &bFE&r from the top and the sides."
		"- Extract the &bCarbon Exhaust&r through pipes."
		"- Set the mixture from 70% to 140% on the Process tab."
		""
		"A lean mixture gets more FE from each mB and makes less exhaust. A rich mixture gives more FE/t and much more exhaust."
		""
		"&7&oNote: The Combustor stops when the exhaust tank is full. Send the exhaust to an Algae Photobioreactor, or void it with the purge button.&r"
	]
	quest.7106E7A1B10F0120.quest_subtitle: "Stage 5 gas power."
	quest.7106E7A1B10F0120.title: "Syngas Combustor"
	quest.7106E7A1B10F0130.quest_desc: [
		"The &eMelter&r makes &bMethane&r from &eAlgae Biomass&r, &eOrganic Reagent&r, and &bWater&r. The &eSteam Methane Reformer&r uses the Methane to make &bHydrogen&r."
		""
		"&aUse:&r"
		"1. Grow &eAlgae Biomass&r in an &eAlgae Photobioreactor&r."
		"2. Crush potatoes, carrots, or plant biomass in a &eCrusher&r to get &eOrganic Reagent&r."
		"3. Insert both items in the &eMelter&r with 1,000 mB of &bWater&r."
		"4. Make sure that the Melter reaches 1,400 °C or more."
		""
		"Each melt makes 1,000 mB of &bMethane&r."
		""
		"&7&oNote: Dense Algae Biomass does not work in the Melter.&r"
	]
	quest.7106E7A1B10F0130.quest_subtitle: "Algae Biomass makes Methane."
	quest.7106E7A1B10F0130.title: "Methane from Biomass"
	quest.7106E7A1B10F0140.quest_desc: [
		"The &eSteam Methane Reformer&r is the Stage 6 &bHydrogen&r source for ammonia. It also makes &bCarbon Monoxide&r."
		""
		"&aBuild:&r"
		"1. Craft two &eReforming Catalyst Beds&r. The Reformer recipe uses one."
		"2. Craft a &eSteam Methane Reformer&r."
		"3. Install a Stage 6 or higher Heat Core and a Reforming Catalyst Bed in the Gear tab."
		""
		"&aUse:&r"
		"- Fill the tanks with &bMethane&r and &bWater&r."
		"- Supply &bFE&r."
		"- Extract &bHydrogen&r and &bCarbon Monoxide&r through pipes."
		""
		"Each run uses 1,000 mB of gas and 500 mB of Water. Methane makes 1,500 mB of Hydrogen, but Syngas makes only 500 mB. Both make 500 mB of Carbon Monoxide."
		""
		"A second Reformer can shift the &bCarbon Monoxide&r into more Hydrogen. This water-gas shift uses 500 mB of Carbon Monoxide and 500 mB of &bWater&r."
		"It makes 500 mB of &bHydrogen&r and 125 mB of &bCarbon Exhaust&r. Pipe the Carbon Monoxide of the first Reformer into the second Reformer."
		"A Reformer cannot start a shift while its second output tank holds Carbon Monoxide."
		""
		"&7&oNote: The Reformer stops when an output tank is full. Carbon Monoxide is the fastest carbon input for the Algae Photobioreactor.&r"
		"&7&oNote: Algae grow half as fast on Carbon Exhaust as on Carbon Monoxide. A shift loop needs about twice the Photobioreactors.&r"
	]
	quest.7106E7A1B10F0140.quest_subtitle: "Methane and water make Hydrogen."
	quest.7106E7A1B10F0140.title: "Steam Methane Reformer"
	quest.7106E7A1B10F0200.quest_desc: [
		"RNGTech ores have a hardness from 1 to 8. A Modular Pick or Hammer mines ore up to the hardness of its head. Ore that is too hard drops nothing."
		""
		"- 1: Flint and Iron heads. Iron and Copper ore."
		"- 2: Copper and Bronze heads. Tin, Zinc, and Gold ore."
		"- 3: Steel heads. Nickel, Lead, and Silver ore."
		"- 4: Steel heads with a &eDiamond Tip&r. Aluminum and Osmium ore."
		"- 5: Aluminum heads. Titanium ore."
		"- 6: Titanium heads. Tungsten and Platinum ore."
		"- 7: Tungstensteel and Nullite heads. No ore by default."
		"- 8: Exotic heads. Naquadah ore."
		""
		"Ores from other mods have the hardness of their metal. By default, a vanilla stone pickaxe reaches hardness 1, and an iron or better pickaxe reaches hardness 2."
		""
		"&7&oNote: The modpack can change these rules and can restrict vanilla tools.&r"
	]
	quest.7106E7A1B10F0200.quest_subtitle: "Better heads mine harder ore."
	quest.7106E7A1B10F0200.title: "Read: Hardness Scale"
	quest.7106E7A1B10F0210.quest_desc: [
		"Flint heads and Iron heads reach ore hardness 1. This level has these blocks:"
		"- &eIron Ore&r"
		"- &eDeepslate Iron Ore&r"
		"- &eCopper Ore&r"
		"- &eDeepslate Copper Ore&r"
	]
	quest.7106E7A1B10F0210.quest_subtitle: "This band is ore hardness 1."
	quest.7106E7A1B10F0210.title: "Flint and Iron Reach"
	quest.7106E7A1B10F0212.quest_desc: ["Collect 4 &eRaw Iron&r. The quest does not take the items. The reward gives you 4 more &eRaw Iron&r."]
	quest.7106E7A1B10F0212.quest_subtitle: "This quest is optional."
	quest.7106E7A1B10F0212.title: "Raw Iron Sample"
	quest.7106E7A1B10F0215.quest_desc: ["Collect 4 &eRaw Copper&r. The quest does not take the items. The reward gives you 4 more &eRaw Copper&r."]
	quest.7106E7A1B10F0215.quest_subtitle: "This quest is optional."
	quest.7106E7A1B10F0215.title: "Raw Copper Sample"
	quest.7106E7A1B10F0220.quest_desc: [
		"Copper heads and Bronze heads reach ore hardness 2. This level adds these blocks:"
		"- &eTin Ore&r"
		"- &eDeepslate Tin Ore&r"
		"- &eZinc Ore&r"
		"- &eDeepslate Zinc Ore&r"
		"- &eGold Ore&r"
		"- &eDeepslate Gold Ore&r"
		""
		"&7&oNote: By default, a vanilla iron pickaxe also reaches this level.&r"
	]
	quest.7106E7A1B10F0220.quest_subtitle: "This band is ore hardness 2."
	quest.7106E7A1B10F0220.title: "Copper and Bronze Reach"
	quest.7106E7A1B10F0222.quest_desc: ["Collect 4 &eRaw Tin&r. The quest does not take the items. The reward gives you 4 more &eRaw Tin&r."]
	quest.7106E7A1B10F0222.quest_subtitle: "This quest is optional."
	quest.7106E7A1B10F0222.title: "Raw Tin Sample"
	quest.7106E7A1B10F0225.quest_desc: ["Collect 4 &eRaw Zinc&r. The quest does not take the items. The reward gives you 4 more &eRaw Zinc&r."]
	quest.7106E7A1B10F0225.quest_subtitle: "This quest is optional."
	quest.7106E7A1B10F0225.title: "Raw Zinc Sample"
	quest.7106E7A1B10F0228.quest_desc: ["Collect 4 &eRaw Gold&r. The quest does not take the items. The reward gives you 4 more &eRaw Gold&r."]
	quest.7106E7A1B10F0228.quest_subtitle: "This quest is optional."
	quest.7106E7A1B10F0228.title: "Raw Gold Sample"
	quest.7106E7A1B10F0230.quest_desc: [
		"Steel heads reach ore hardness 3. This level adds these blocks:"
		"- &eNickel Ore&r"
		"- &eDeepslate Nickel Ore&r"
		"- &eLead Ore&r"
		"- &eDeepslate Lead Ore&r"
		"- &eSilver Ore&r"
		"- &eDeepslate Silver Ore&r"
	]
	quest.7106E7A1B10F0230.quest_subtitle: "This band is ore hardness 3."
	quest.7106E7A1B10F0230.title: "Steel Reach"
	quest.7106E7A1B10F0232.quest_desc: ["Collect 4 &eRaw Nickel&r. The quest does not take the items. The reward gives you 4 more &eRaw Nickel&r."]
	quest.7106E7A1B10F0232.quest_subtitle: "This quest is optional."
	quest.7106E7A1B10F0232.title: "Raw Nickel Sample"
	quest.7106E7A1B10F0235.quest_desc: ["Collect 4 &eRaw Lead&r. The quest does not take the items. The reward gives you 4 more &eRaw Lead&r."]
	quest.7106E7A1B10F0235.quest_subtitle: "This quest is optional."
