	quest.72A7C90BCF639C85.quest_desc: ["Swap to something harder with more durability than copper"]
	quest.72EA1D02D33FF39B.quest_desc: [
		"Adds an affix to the item. For magic items the limit is 2 affixes, for rare it's 6."
		"Later in the game you will be allowed to ascend magic items into rare"
	]
	quest.7431964561B74763.quest_desc: ["This is just a hint you unlocked a new hardness level. Make sure to check out the scale at Start quest line"]
	quest.74C2A8758BA6E314.quest_desc: [
		"Grab the reward from the previous quest. "
		""
		"Most modifiable RNGTech items have &3Refinement Potential&r, or RP."
		""
		"RP is the budget spent when you improve, reroll, add, or remove affixes."
		""
		"- &eMagic&r items can start with 1-2 affixes."
		"- &eRare&r items can start with 3-6 affixes."
		"- &eStage&r influences how strong natural affix tiers can be."
		"- You can turn a Magic item into Rare using ascension."
		""
		"&3Tip:&r Do not spend RP blindly. Make sure to follow the Affix Forge quest line."
		""
		"&2Upgrade:&r"
		"- Take your component"
		"- Insert it into Tool Bench"
		"- Add either Affix Injection"
		"- Click Apply"
		""
		""
		""
		"&3Tip:&r IF you already combined your tool you can always dissamble without loss"
	]
	quest.74C2A8758BA6E314.title: "Affixes"
	quest.75A6F1710FAEBD6C.quest_desc: [
		"Optional. &eCopper Solar Panels&r are the first solar upgrade after crude daylight power."
		""
		"The Solar Array Controller allows you to pool multiple panels and apply bonuses."
		""
		"&aBuild:&r"
		"- Craft a &eCopper Solar Panel&r."
		""
		"&aUse:&r"
		"- Use it as supplemental daytime power."
		"- Save larger solar planning for the array controller branch."
	]
	quest.75A6F1710FAEBD6C.quest_subtitle: "Better daylight trickle."
	quest.75A6F1710FAEBD6C.title: "Copper Solar"
	quest.77BDE15168C209AE.quest_desc: ["To charge tools you can add a connector to Tool Bench"]
	quest.7E96148C6A2F7B94.quest_desc: [
		"&eCopper&r opens early conductive parts, heat cores, cells, and sidegrade machines."
		""
		"&aBuild:&r"
		"- Collect a &eCopper Ingot&r."
		""
		"&aUse:&r"
		"- Use Copper for transfer, heat, and early power branches."
		"- Do not skip the Crude Metal Press when Copper Furnace circuits block progress."
	]
	quest.7E96148C6A2F7B94.quest_subtitle: "Conductive parts start here."
	quest.7E96148C6A2F7B94.title: "First Copper"
	quest.83437B2BE1852F4E.quest_desc: [
		"Upgrade a Primed Seal Core in the Component Assembler with a Tungstensteel Casing, a Nullite Coil, an Elite Electric Circuit, and 1,000 mB of Lubricant."
	]
	quest.83437B2BE1852F4E.quest_subtitle: "Stage 7 precision."
	quest.83437B2BE1852F4E.title: "Lubricated Seal Core"
	quest.866D43F46AC8E5BE.quest_desc: [
		"Assemble a &ePrimed Seal Core&r in the &eComponent Assembler&r from a Sparksteel Coil, an Aluminum Casing, four redstone, a Stabilization Catalyst, and 1,000 mB of Electrolyte Solution."
	]
	quest.866D43F46AC8E5BE.quest_subtitle: "The heart of a Seal."
	quest.866D43F46AC8E5BE.title: "Primed Seal Core"
	quest.9978E0313902657D.quest_desc: [
		"From Stage 5, a machine can specialize. Open the crest beside its start node on the Mastery tab and press &aAscend&r with an &eAscendancy Seal&r in your inventory."
		""
		"- Seal I needs a Stage 4+ chassis, or a Stage 4+ tool head on a Forestry Companion, and chooses one of the family's two ascendancies."
		"- Each Seal grants &a2&r ascendancy points, for 6 across Seals I, II, and III."
		"- An ascendancy node costs five Mastery Refunds to refund. Switching needs an empty tree and another Seal I."
		""
		"&7&oTip: each machine's wiki page lists both of its ascendancies.&r"
	]
	quest.9978E0313902657D.quest_subtitle: "Two paths per machine."
	quest.9978E0313902657D.title: "Read: Ascendancies"
	quest.B707E4F323CE4189.quest_desc: [
		"Frame the core with Sparksteel Plates, Aluminum Casings, Advanced Electric Circuits, and a &eStage 5 calibrated conductive component&r of 70+ stability."
		""
		"Calibrate a Sparksteel Coil in a Steel Resonance Calibrator to get one. A Stabilizer Matrix recipe accepts components down to 55 stability."
		""
		"Use it on a machine you plan to keep. The ascendancy stays with that chassis."
	]
	quest.B707E4F323CE4189.quest_subtitle: "Choose a path."
	quest.B707E4F323CE4189.title: "Ascendancy Seal I"
	quest.C3604160EA637458.quest_desc: [
		"Craft &eMastery Refunds&r from paper, redstone, and a copper ingot, eight at a time."
		""
		"One refund removes a shared-tree node. An ascendancy node costs five."
	]
	quest.C3604160EA637458.quest_subtitle: "Change your mind."
	quest.C3604160EA637458.title: "Mastery Refunds"
	quest.FAEF4E1A8753B3FE.quest_desc: [
		"Sneak-use the &eConfigurator&r in the air to switch it to Mastery mode."
		""
		"Sneak-use a machine to copy its build, then use another machine of the same start to paste it. The target follows the build as it earns points."
	]
	quest.FAEF4E1A8753B3FE.quest_subtitle: "One build, many machines."
	quest.FAEF4E1A8753B3FE.title: "Copy a Build"
	quest.FB45A90F15D87663.quest_desc: [
		"Every machine levels up from the work it finishes. Open its &eMastery&r tab to spend points in the shared passive tree."
		""
		"- Mastery belongs to the chassis. Breaking and replacing the machine keeps it."
		"- Hover a node to preview its route and cost, then click to allocate the whole route."
		"- Right-click an allocated node to refund it for one &eMastery Refund&r."
		"- &eCopy&r and &ePaste&r move a build between machines that share a start."
	]
	quest.FB45A90F15D87663.quest_subtitle: "Machines are characters too."
	quest.FB45A90F15D87663.title: "Read: Machine Mastery"
