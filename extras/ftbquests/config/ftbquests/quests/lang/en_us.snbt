	quest.7106E7A1B10F0262.quest_desc: ["Collect 4 &eRaw Titanium&r. The quest does not take the items. The reward gives you 4 more &eRaw Titanium&r."]
	quest.7106E7A1B10F0262.quest_subtitle: "This quest is optional."
	quest.7106E7A1B10F0262.title: "Raw Titanium Sample"
	quest.7106E7A1B10F0270.quest_desc: [
		"Titanium heads reach ore hardness 6. This level adds these blocks:"
		"- &eTungsten Ore&r"
		"- &eDeepslate Tungsten Ore&r"
		"- &ePlatinum Ore&r"
		"- &eDeepslate Platinum Ore&r"
	]
	quest.7106E7A1B10F0270.quest_subtitle: "This band is ore hardness 6."
	quest.7106E7A1B10F0270.title: "Tungsten and Platinum Reach"
	quest.7106E7A1B10F0272.quest_desc: ["Collect 4 &eRaw Tungsten&r. The quest does not take the items. The reward gives you 4 more &eRaw Tungsten&r."]
	quest.7106E7A1B10F0272.quest_subtitle: "This quest is optional."
	quest.7106E7A1B10F0272.title: "Raw Tungsten Sample"
	quest.7106E7A1B10F0275.quest_desc: ["Collect 4 &eRaw Platinum&r. The quest does not take the items. The reward gives you 4 more &eRaw Platinum&r."]
	quest.7106E7A1B10F0275.quest_subtitle: "This quest is optional."
	quest.7106E7A1B10F0275.title: "Raw Platinum Sample"
	quest.7106E7A1B10F0280.quest_desc: [
		"Tungstensteel heads and Nullite heads reach ore hardness 7."
		""
		"By default, no ore blocks have hardness 7. A modpack can add ores to this level."
	]
	quest.7106E7A1B10F0280.quest_subtitle: "This band is ore hardness 7."
	quest.7106E7A1B10F0280.title: "Reserved Late-Game Reach"
	quest.7106E7A1B10F0290.quest_desc: [
		"Exotic heads reach ore hardness 8. This level adds these blocks:"
		"- &eNaquadah Ore&r"
		"- &eDeepslate Naquadah Ore&r"
	]
	quest.7106E7A1B10F0290.quest_subtitle: "This band is ore hardness 8."
	quest.7106E7A1B10F0290.title: "Exotic Reach"
	quest.7106E7A1B10F0292.quest_desc: ["Collect 4 &eRaw Naquadah&r. The quest does not take the items. The reward gives you 4 more &eRaw Naquadah&r."]
	quest.7106E7A1B10F0292.quest_subtitle: "This quest is optional."
	quest.7106E7A1B10F0292.title: "Raw Naquadah Sample"
	quest.7106E7A1B10F0300.quest_desc: [
		"These quests show the Stage 5 and Stage 6 Crusher, Furnace, and Resonance Calibrator sets. All of them are optional."
		""
		"&7&oNote: A chassis accepts Gear of its own stage or lower. You can mix Gear from different stages.&r"
	]
	quest.7106E7A1B10F0300.quest_subtitle: "Stage 5 and 6 machine sets."
	quest.7106E7A1B10F0300.title: "Alternatives"
	quest.7106E7A1B10F0302.quest_desc: [
		"Each quest shows one set of Crusher chassis, Crush Head, and Battery Cell."
		""
		"&7&oNote: A chassis accepts Gear of its own stage or lower. You can mix Gear from different stages.&r"
	]
	quest.7106E7A1B10F0302.quest_subtitle: "Stage 5 and 6 Crusher sets."
	quest.7106E7A1B10F0302.title: "Crusher Alternatives"
	quest.7106E7A1B10F0304.quest_desc: [
		"The &eAluminum Crusher Chassis&r is fast and efficient, but it has a smaller energy buffer. The &eAluminum Crush Head&r has hardness 5."
		""
		"&aBuild:&r"
		"- Craft an &eAluminum Crusher Chassis&r."
		"- Install an &eAluminum Crush Head&r and an &eInvar Battery Cell&r."
		""
		"&7&oNote: A chassis accepts Gear of its own stage or lower. You can mix Gear from different stages.&r"
	]
	quest.7106E7A1B10F0304.quest_subtitle: "Fast Stage 5 Crusher set."
	quest.7106E7A1B10F0304.title: "Aluminum Crusher Set"
	quest.7106E7A1B10F0308.quest_desc: [
		"The &eTitanium Crusher Chassis&r has high throughput, stronger output, and Output Guard. The &eTitanium Crush Head&r has hardness 6."
		""
		"&aBuild:&r"
		"- Craft a &eTitanium Crusher Chassis&r."
		"- Install a &eTitanium Crush Head&r and a &eSparksteel Battery Cell&r."
		""
		"&7&oNote: The Melter needs a Crush Head with hardness 6 or higher, such as the Titanium Crush Head.&r"
		"&7&oNote: A chassis accepts Gear of its own stage or lower. You can mix Gear from different stages.&r"
	]
	quest.7106E7A1B10F0308.quest_subtitle: "Stage 6 Crusher set."
	quest.7106E7A1B10F0308.title: "Titanium Crusher Set"
	quest.7106E7A1B10F0310.quest_desc: [
		"Each quest shows one set of Furnace chassis, Heat Core, and Battery Cell."
		""
		"&7&oNote: A chassis accepts Gear of its own stage or lower. You can mix Gear from different stages.&r"
	]
	quest.7106E7A1B10F0310.quest_subtitle: "Stage 5 and 6 Furnace sets."
	quest.7106E7A1B10F0310.title: "Furnace Alternatives"
	quest.7106E7A1B10F0312.quest_desc: [
		"The &eAluminum Furnace Chassis&r is fast and efficient, with quick heat transfer."
		""
		"The &eAluminum Heat Core&r heats up much faster than other cores. It reaches only 850 °C without affixes. This is enough for Iron and Copper only."
		""
		"&aBuild:&r"
		"- Craft an &eAluminum Furnace Chassis&r."
		"- Install an &eAluminum Heat Core&r and an &eInvar Battery Cell&r."
		""
		"&7&oNote: A chassis accepts Gear of its own stage or lower. You can mix Gear from different stages.&r"
	]
	quest.7106E7A1B10F0312.quest_subtitle: "Fast low-heat Furnace set."
	quest.7106E7A1B10F0312.title: "Aluminum Furnace Set"
	quest.7106E7A1B10F0316.quest_desc: [
		"The &eTitanium Furnace Chassis&r is a high-heat chassis. The &eTitanium Heat Core&r reaches 1,800 °C without affixes."
		""
		"&aBuild:&r"
		"- Craft a &eTitanium Furnace Chassis&r."
		"- Install a &eTitanium Heat Core&r and a &eSparksteel Battery Cell&r."
		""
		"&7&oNote: The Titanium Furnace Chassis recipe needs an Elite Electric Circuit.&r"
		"&7&oNote: A chassis accepts Gear of its own stage or lower. You can mix Gear from different stages.&r"
	]
	quest.7106E7A1B10F0316.quest_subtitle: "Stage 6 high-heat Furnace set."
	quest.7106E7A1B10F0316.title: "Titanium Furnace Set"
	quest.7106E7A1B10F0320.quest_desc: [
		"This quest shows the Stage 6 Resonance Calibrator set. The Stage 7 sets are in the Stage 7+ chapter."
		""
		"&7&oNote: A chassis accepts Gear of its own stage or lower. You can mix Gear from different stages.&r"
	]
	quest.7106E7A1B10F0320.quest_subtitle: "Stage 6 Resonance Calibrator set."
	quest.7106E7A1B10F0320.title: "Resonance Alternatives"
	quest.7106E7A1B10F0322.quest_desc: [
		"The &eAdvanced Machine Frame&r needs a calibrated component of Stage 2 or higher. The Iron Resonance Calibrator cannot make it."
		""
		"The &eSteel Resonance Calibrator&r is slower but more stable. It also runs the Stage 4 recipes, such as the calibrated Sparksteel Coil for the &eMelter&r."
		""
		"&aBuild:&r"
		"- Craft a &eSteel Resonance Calibrator Chassis&r."
		"- Install a &eSteel Resonance Coil&r and a &eSteel Control Board&r."
		"- Install a &eSteel Stabilizer Matrix&r and an &eInvar Battery Cell&r."
		""
		"&7&oNote: A calibration recipe runs only when the chassis and the Resonance Coil both reach its stage.&r"
		"&7&oNote: A chassis accepts Gear of its own stage or lower. You can mix Gear from different stages.&r"
	]
	quest.7106E7A1B10F0322.quest_subtitle: "Stable Stage 4 Calibrator set."
	quest.7106E7A1B10F0322.title: "Steel Resonance Set"
	quest.7106E7A1B10F0328.quest_desc: [
		"The &eTitanium Resonance Calibrator&r is the Stage 6 precision chassis. It has better speed, stability, and Refinement Potential."
		""
		"It is the first chassis for Stage 5 and 6 recipes, such as the &eCavitation Rotor Hub&r and the &eCalibrated Diamond Crystal&r."
		""
		"&aBuild:&r"
		"- Craft a &eTitanium Resonance Calibrator Chassis&r."
		"- Install a &eTitanium Resonance Coil&r and a &eTitanium Control Board&r."
		"- Install a &eTitanium Stabilizer Matrix&r and a &eSparksteel Battery Cell&r."
		""
		"&7&oNote: A calibration recipe runs only when the chassis and the Resonance Coil both reach its stage.&r"
		"&7&oNote: A chassis accepts Gear of its own stage or lower. You can mix Gear from different stages.&r"
	]
	quest.7106E7A1B10F0328.quest_subtitle: "Stage 6 precision Calibrator set."
	quest.7106E7A1B10F0328.title: "Titanium Resonance Set"
	quest.7106E7A1B10F0400.quest_desc: [
		"Stage 8 Exotic is the top RNGTech stage. These quests show the Exotic Crusher and Furnace sets and the Stage 7 Resonance Calibrator sets."
		""
		"&7&oNote: A chassis accepts Gear of its own stage or lower. You can mix Gear from different stages.&r"
	]
	quest.7106E7A1B10F0400.quest_subtitle: "Stage 7 and 8 machine sets."
	quest.7106E7A1B10F0400.title: "Exotic Alternatives"
	quest.7106E7A1B10F0402.quest_desc: [
		"This quest shows the Stage 8 Crusher set."
		""
		"&7&oNote: A chassis accepts Gear of its own stage or lower. You can mix Gear from different stages.&r"
	]
	quest.7106E7A1B10F0402.quest_subtitle: "Stage 8 Crusher set."
	quest.7106E7A1B10F0402.title: "Crusher Alternatives"
	quest.7106E7A1B10F0404.quest_desc: [
		"The &eExotic Crusher Chassis&r crushes up to 9 items in each cycle. It has Output Guard and the largest internal buffer. The &eExotic Crush Head&r has hardness 8."
		""
		"&aBuild:&r"
		"- Craft an &eExotic Crusher Chassis&r."
		"- Install an &eExotic Crush Head&r and an &eExotic Battery Cell&r."
		""
		"&7&oNote: A chassis accepts Gear of its own stage or lower. You can mix Gear from different stages.&r"
	]
	quest.7106E7A1B10F0404.quest_subtitle: "Stage 8 Crusher set."
	quest.7106E7A1B10F0404.title: "Exotic Crusher Set"
	quest.7106E7A1B10F0410.quest_desc: [
		"This quest shows the Stage 8 Furnace set."
		""
		"&7&oNote: A chassis accepts Gear of its own stage or lower. You can mix Gear from different stages.&r"
	]
	quest.7106E7A1B10F0410.quest_subtitle: "Stage 8 Furnace set."
	quest.7106E7A1B10F0410.title: "Furnace Alternatives"
	quest.7106E7A1B10F0412.quest_desc: [
		"The &eExotic Furnace Chassis&r is the Stage 8 Furnace. The &eExotic Heat Core&r reaches 2,200 °C without affixes, enough for every metal recipe."
		""
		"&aBuild:&r"
		"- Craft an &eExotic Furnace Chassis&r."
		"- Install an &eExotic Heat Core&r and an &eExotic Battery Cell&r."
		""
		"&7&oNote: A chassis accepts Gear of its own stage or lower. You can mix Gear from different stages.&r"
	]
	quest.7106E7A1B10F0412.quest_subtitle: "Stage 8 Furnace set."
	quest.7106E7A1B10F0412.title: "Exotic Furnace Set"
	quest.7106E7A1B10F0420.quest_desc: [
		"These quests show the two Stage 7 Resonance Calibrator sets. Tungstensteel is the bulk branch, and Nullite is the precision branch."
		""
		"&7&oNote: A chassis accepts Gear of its own stage or lower. You can mix Gear from different stages.&r"
	]
	quest.7106E7A1B10F0420.quest_subtitle: "Stage 7 Calibrator sets."
	quest.7106E7A1B10F0420.title: "Resonance Alternatives"
	quest.7106E7A1B10F0422.quest_desc: [
		"The &eTungstensteel Resonance Calibrator&r has three lanes. It calibrates three copies of the input in each cycle, and each copy uses its own FE."
		""
		"&aBuild:&r"
		"- Craft a &eTungstensteel Resonance Calibrator Chassis&r."
		"- Install a &eTungstensteel Resonance Coil&r and a &eTungstensteel Control Board&r."
		"- Install a &eTungstensteel Stabilizer Matrix&r and a &eNullite Battery Cell&r."
		""
		"&7&oNote: A chassis accepts Gear of its own stage or lower. You can mix Gear from different stages.&r"
	]
	quest.7106E7A1B10F0422.quest_subtitle: "Three-lane bulk Calibrator set."
	quest.7106E7A1B10F0422.title: "Tungstensteel Resonance Set"
	quest.7106E7A1B10F0428.quest_desc: [
		"The &eNullite Resonance Calibrator&r is the late precision chassis. It gives the best calibration quality and Refinement Potential."
		""
		"&aBuild:&r"
		"- Craft a &eNullite Resonance Calibrator Chassis&r."
		"- Install a &eNullite Resonance Coil&r and a &eNullite Control Board&r."
		"- Install a &eNullite Stabilizer Matrix&r and an &eExotic Battery Cell&r."
		""
		"&7&oNote: A chassis accepts Gear of its own stage or lower. You can mix Gear from different stages.&r"
	]
	quest.7106E7A1B10F0428.quest_subtitle: "Best precision Calibrator set."
	quest.7106E7A1B10F0428.title: "Nullite Resonance Set"
	quest.724590047E493088.quest_desc: [
		"The &eConnector Mold&r presses Energy, Fluid, and Item Connectors."
		""
		"&aBuild:&r"
		"1. Craft a &eConnector Mold&r. Its recipe needs Steel Ingots."
		"2. Install it in a press and select it."
		"3. Press a Copper Coil into 2 &eCopper Energy Connectors&r."
		""
		"&7&oNote: Connector recipes need 1.0 Temperature Stability. The Energy Coil for the Resonance Calibrator uses Copper Energy Connectors.&r"
	]
	quest.724590047E493088.quest_subtitle: "Press connectors for cables and coils."
	quest.724590047E493088.title: "Improved Connection"
	quest.72A7C90BCF639C85.quest_desc: [
		"The &eIron Pick Head&r has more durability than the &eCopper Pick Head&r. It mines a little slower."
		""
		"The Iron head reaches only ore hardness 1, the same as a Flint head. Use a Copper head for Tin, Zinc, and Gold ore."
	]
	quest.72EA1D02D33FF39B.quest_desc: [
		"The &eAffix Injector&r adds one affix to an item. It costs 1 to 8 RP."
		"- A Normal item becomes Magic."
		"- A Magic item can only fill its empty prefix or suffix. The limit is 2 affixes."
		"- A Rare item takes new affixes until it is full. The limit is 6 affixes."
		""
		"To make a Magic item Rare, use an &eAscension Catalyst&r. It needs the Affix Resonance Matrix."
	]
	quest.7431964561B74763.quest_desc: [
		"A &eSteel Pick Head&r mines ore up to hardness 3: Nickel, Lead, and Silver."
		"A Steel Pick Head with a &eDiamond Tip&r reaches hardness 4: Aluminum and Osmium."
		""
		"&7&oNote: The Start chapter shows the ore hardness of each pick head.&r"
	]
	quest.74C2A8758BA6E314.quest_desc: [
		"Claim the 2 &eAffix Injectors&r from the Tool Components quest first."
		""
		"Most rolled RNGTech items have Refinement Potential (RP). RP is the budget that you spend to add, upgrade, reroll, or remove affixes."
		""
		"- Normal items have no affixes."
		"- Magic items have up to 1 prefix and 1 suffix."
		"- Rare items have up to 3 prefixes and 3 suffixes."
		"- The item stage sets the natural affix tier and the RP budget."
		"- An &eAscension Catalyst&r or &eAscension Matrix&r makes a Magic item Rare."
		""
		"&aUse:&r"
		"1. Open the Refine tab of the &eTool Bench&r."
		"2. Insert an identified Tool Head or Tool Rod."
		"3. Insert an &eAffix Injector&r in the Catalyst slot."
		"4. Click Apply."
		""
		"An &eAffix Injector&r adds one affix. A Normal item becomes Magic. A Magic item with 2 affixes is full."
		""
		"You can also refine the head or rod of an assembled tool. Put the tool in the Tool slot of the Refine tab, then select Head or Rod."
		""
		"&7&oNote: Stage 0 parts have little RP. The Affix Forge chapter explains RP costs.&r"
	]
	quest.74C2A8758BA6E314.quest_subtitle: "Spend Refinement Potential with care."
	quest.74C2A8758BA6E314.title: "Affixes"
	quest.75A6F1710FAEBD6C.quest_desc: [
		"Optional. &eCopper Solar Panels&r are the first solar upgrade after crude daylight power."
		""
		"The Solar Array Controller allows you to pool multiple panels and apply bonuses."
		""
		"&aBuild:&r"
		"- Craft a &eCopper Solar Panel&r."
		""
		"&aUse:&r"
		"- Use it as supplemental daytime power."
		"- Save larger solar planning for the array controller branch."
	]
	quest.75A6F1710FAEBD6C.quest_subtitle: "Better daylight trickle."
	quest.75A6F1710FAEBD6C.title: "Copper Solar"
	quest.760227B83533AF3C.quest_desc: [
		"Optional. Place a Redstone Comparator next to an RNGTech machine. The signal strength shows the machine state:"
		"- 15: the machine is blocked, for example with no power or a full output."
		"- 8: the machine works."
		"- 4: a redstone signal pauses the machine."
		"- 1: the machine is idle and has nothing to do."
		""
		"&aUse:&r"
		"- Connect the comparator to a lamp or a note block. It then shows when a line stops."
	]
	quest.760227B83533AF3C.quest_subtitle: "A comparator shows the machine state."
	quest.760227B83533AF3C.title: "Comparator Output"
	quest.77BDE15168C209AE.quest_desc: [
		"With an Energy Connector in its Gear tab, the &eTool Bench&r charges the Battery Cell of a tool."
		""
		"&aBuild:&r"
		"- Craft a &eCrude Energy Connector&r."
		"- Install it in the Gear tab of the &eTool Bench&r."
		""
		"&aUse:&r"
		"- Supply &bFE&r to any side of the bench, for example from a &eCrude Solid Fuel Burner&r next to it."
		"- Put a tool with a Battery Cell in the Tool slot."
		"- The &eCrude Energy Connector&r moves up to 64 &bFE/t&r."
		"- The bench also charges a &eMiner's Companion&r in the Tool slot."
		""
		"&7&oNote: The Battery Support of the rod sets the highest cell stage. A Wooden Tool Rod takes only Stage 0 cells.&r"
	]
	quest.77BDE15168C209AE.quest_subtitle: "Let the Tool Bench charge tools."
	quest.77BDE15168C209AE.title: "Tool Charging"
	quest.7881F937740ED4E4.quest_desc: [
		"The &eTitanium Compressor Tank&r stores 96,000 mB loose and 2,304,000 mB compressed. It accepts Gear up to Stage 6."
		"Craft it from a &ePressure Tank Frame&r, 4 glass, and 4 titanium ingots."
	]
	quest.7983B2FDA710DE9A.quest_desc: [
		"A machine with Mastery earns XP from the jobs that it finishes. Each level gives one point. Spend the points in the shared passive tree on the &eMastery&r tab."
		""
		"- Crushers, Furnaces, Alloy Furnaces, Metal Presses, Resonance Calibrators, Melters, and the Forestry Companion have Mastery."
		"- Mastery belongs to the machine. When you break it with the correct tool, it keeps its progress."
		"- Harder work gives more XP. When the machine level is above the work level, the XP decreases."
		"- Hover over a node to see its path and cost. Click to allocate the full path."
		"- Right-click an allocated node to refund it for one &eMastery Refund&r."
		""
		"The tree has three attributes: Control, Drive, and Reserve. Some notables convert an attribute into another stat, so it is good to stack one attribute."
		"Keystones are large trade-offs. Some keystones, such as Even Feed, only change how the machine works."
		""
		"&7&oNote: &eCopy&r and &ePaste&r on the Mastery tab move a build code between machines that share a start.&r"
	]
	quest.7983B2FDA710DE9A.quest_subtitle: "Machines level up from their work."
	quest.7983B2FDA710DE9A.title: "Read: Machine Mastery"
	quest.7BCD8236CD2689BB.quest_desc: [
		"The &eIron Tool Rod&r has more durability and &bFE&r transfer than the &eWooden Tool Rod&r. It supports Stage 1 Battery Cells, such as the &eIron Battery Cell&r."
		""
		"&aBuild:&r"
		"- Craft an &eIron Tool Rod&r from an &eIron Plate&r and 2 &eIron Rods&r."
		""
		"&aUse:&r"
		"1. Put your tool in the Tool slot of the &eTool Bench&r."
		"2. Insert the &eIron Tool Rod&r in the Rod slot."
		"3. Click Apply. The old rod comes back with its rolls."
	]
	quest.7BCD8236CD2689BB.quest_subtitle: "A stronger rod that takes Iron cells."
	quest.7BCD8236CD2689BB.title: "Iron Tool Rod"
	quest.7D07C6C36A40B121.quest_desc: ["The &eGreater Affix Upgrader&r upgrades one random affix. If all affixes are at their top tier, it retunes one affix. It costs 6 to 10 RP."]
	quest.7E96148C6A2F7B94.quest_desc: [
		"&eCopper&r opens early conductive parts, heat cores, cells, and sidegrade machines."
		""
		"&aBuild:&r"
		"- Collect a &eCopper Ingot&r."
		""
		"&aUse:&r"
		"- Use Copper for transfer, heat, and early power branches."
		"- Do not skip the Crude Metal Press when Copper Furnace circuits block progress."
	]
	quest.7E96148C6A2F7B94.quest_subtitle: "Conductive parts start here."
	quest.7E96148C6A2F7B94.title: "First Copper"
