	quest.7106E7A1B10F0238.quest_desc: ["Collect 4 &eRaw Silver&r. The quest does not take the items. The reward gives you 4 more &eRaw Silver&r."]
	quest.7106E7A1B10F0238.quest_subtitle: "This quest is optional."
	quest.7106E7A1B10F0238.title: "Raw Silver Sample"
	quest.7106E7A1B10F0240.quest_desc: [
		"A &eSteel Pick Head&r or &eSteel Hammer Head&r with a &eDiamond Tip&r reaches ore hardness 4. This level adds these blocks:"
		"- &eAluminum Ore&r"
		"- &eDeepslate Aluminum Ore&r"
		"- &eOsmium Ore&r"
		"- &eDeepslate Osmium Ore&r"
	]
	quest.7106E7A1B10F0240.quest_subtitle: "This band is ore hardness 4."
	quest.7106E7A1B10F0240.title: "Steel with Diamond Tip"
	quest.7106E7A1B10F0242.quest_desc: [
		"Collect 4 &eRaw Aluminum&r. The quest does not take the items. The reward gives you 4 more &eRaw Aluminum&r."
		"This quest opens the Aluminum Foothold quest."
	]
	quest.7106E7A1B10F0242.quest_subtitle: "This quest is optional."
	quest.7106E7A1B10F0242.title: "Raw Aluminum Sample"
	quest.7106E7A1B10F0245.quest_desc: ["Collect 4 &eRaw Osmium&r. The quest does not take the items. The reward gives you 4 more &eRaw Osmium&r."]
	quest.7106E7A1B10F0245.quest_subtitle: "This quest is optional."
	quest.7106E7A1B10F0245.title: "Raw Osmium Sample"
	quest.7106E7A1B10F0250.quest_desc: [
		"Aluminum Ore has ore hardness 4. A Steel head with a &eDiamond Tip&r mines it before you can craft Aluminum heads."
		""
		"Aluminum is the Stage 5 material. Aluminum heads reach ore hardness 5, which opens Titanium Ore."
		""
		"&7&oNote: This quest marks a step in progress. It is not a hardness level.&r"
	]
	quest.7106E7A1B10F0250.quest_subtitle: "Aluminum starts Stage 5."
	quest.7106E7A1B10F0250.title: "Aluminum Foothold"
	quest.7106E7A1B10F0260.quest_desc: [
		"Aluminum heads reach ore hardness 5. This level adds these blocks:"
		"- &eTitanium Ore&r"
		"- &eDeepslate Titanium Ore&r"
