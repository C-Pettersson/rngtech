{
  "multipart": [
    {
      "when": {
        "active": "false",
        "facing": "north"
      },
      "apply": {
        "model": "rngtech:block/melter"
      }
    },
    {
      "when": {
        "active": "false",
        "facing": "east"
      },
      "apply": {
        "model": "rngtech:block/melter",
        "y": 90
      }
    },
    {
      "when": {
        "active": "false",
        "facing": "south"
      },
      "apply": {
        "model": "rngtech:block/melter",
        "y": 180
      }
    },
    {
      "when": {
        "active": "false",
        "facing": "west"
      },
      "apply": {
        "model": "rngtech:block/melter",
        "y": 270
      }
    },
    {
      "when": {
        "active": "true",
        "facing": "north"
      },
      "apply": {
        "model": "rngtech:block/melter_active"
      }
    },
    {
      "when": {
        "active": "true",
        "facing": "east"
      },
      "apply": {
        "model": "rngtech:block/melter_active",
        "y": 90
      }
    },
    {
      "when": {
        "active": "true",
        "facing": "south"
      },
      "apply": {
        "model": "rngtech:block/melter_active",
        "y": 180
      }
    },
    {
      "when": {
        "active": "true",
        "facing": "west"
      },
      "apply": {
        "model": "rngtech:block/melter_active",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "north",
        "work_order": "true"
      },
      "apply": {
        "model": "rngtech:block/melter/job_lamp"
      }
    },
    {
      "when": {
        "facing": "east",
        "work_order": "true"
      },
      "apply": {
        "model": "rngtech:block/melter/job_lamp",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "work_order": "true"
      },
      "apply": {
        "model": "rngtech:block/melter/job_lamp",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "work_order": "true"
      },
      "apply": {
        "model": "rngtech:block/melter/job_lamp",
        "y": 270
      }
    }
  ]
}
